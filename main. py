    def _draw_autosave_counter(self, y_center, x_center=None, group=None):
        if group is None:
            group = self.hud_dynamic_group
        f_size = self.f_size
        digit = getattr(self, '_autosave_digit', None)
        icon_size = max(14, f_size * 1.4)
