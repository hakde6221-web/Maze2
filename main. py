class MazeGeneratorBase:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.grid = None
        self.p_spawn = None
        self.dead_ends = None
        self.target_de = 0

    def _bfs(self, start):
        dist = {start: 0}
        parent = {start: None}
        q = deque([start])
        while q:
            ccx, ccy = q.popleft()
            for d, (dx, dy) in DIRS.items():
                if self.grid[ccy][ccx][d] == 0:
                    nxt = (ccx + dx, ccy + dy)
                    if nxt not in dist:
                        dist[nxt] = dist[(ccx, ccy)] + 1
                        parent[nxt] = (ccx, ccy)
                        q.append(nxt)
        return dist, parent

    def _find_topological_center(self):
        dists1, _ = self._bfs((0, 0))
        n1 = max(dists1, key=dists1.get)
        dists2, parent2 = self._bfs(n1)
        n2 = max(dists2, key=dists2.get)
        path, curr = [], n2
        while curr is not None:
            path.append(curr)
            curr = parent2.get(curr)
        center = path[len(path) // 2]
        cd, _ = self._bfs(center)
        return center, cd

    def _generate_growing_tree(self, p):
        grid = [[{'N': 1, 'S': 1, 'E': 1, 'W': 1} for _ in range(self.w)] for _ in range(self.h)]
        visited = [[False] * self.w for _ in range(self.h)]
        sx, sy = random.randint(0, self.w - 1), random.randint(0, self.h - 1)
        active = [(sx, sy)]
        visited[sy][sx] = True
        while active:
            idx = -1 if random.random() < p else random.randint(0, len(active) - 1)
            cx, cy = active[idx]
            neighbors = []
            for d, (dx, dy) in DIRS.items():
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < self.w and 0 <= ny < self.h and not visited[ny][nx]:
                    neighbors.append((nx, ny, d))
            if neighbors:
                nx, ny, d = random.choice(neighbors)
                grid[cy][cx][d] = 0
                grid[ny][nx][INV_DIRS[d]] = 0
                visited[ny][nx] = True
                active.append((nx, ny))
            else:
                active.pop(idx)
        return grid

    def _count_de(self, g):
        return sum(1 for y in range(self.h) for x in range(self.w)
                   if list(g[y][x].values()).count(1) == 3)


class MazeGenerator20(MazeGeneratorBase):
    def __init__(self, w=MAZE_W, h=MAZE_H, target_de=NUM_DEAD_ENDS):
        super().__init__(w, h)
        self.target_de = target_de
        self.grid = self._generate_base_grid()
        self.dead_ends = [(x, y) for y in range(self.h) for x in range(self.w)
                          if list(self.grid[y][x].values()).count(1) == 3]
        self.p_spawn, _ = self._find_topological_center()

    def _generate_base_grid(self):
        p = 0.5
        temp = None
        for attempt in range(3000):
            temp = self._generate_growing_tree(p)
            count = self._count_de(temp)
            if count == self.target_de:
                return temp
            p = min(0.999, p + 0.004) if count > self.target_de else max(0.001, p - 0.004)
            if attempt % 200 == 199:
                p = random.uniform(0.05, 0.95)
        return temp


