    def _flash_checkpoint(self):
        if not hasattr(self, 'checkpoint_rect'):
            return
        m_top = getattr(self, 'maze_top', self.height * 0.8)
        m_bot = getattr(self, 'maze_bottom', self.height * 0.3)
        tw, th = self._checkpoint_size
        pad = 20
        cx = (self.width - tw) / 2.0
        cy = (m_top + m_bot) / 2.0 - th / 2.0
        self.checkpoint_bg_rect.pos = (cx - pad, cy - pad)
        self.checkpoint_bg_rect.size = (tw + pad * 2, th + pad * 2)
        self.checkpoint_rect.pos = (cx, cy)
        Animation.cancel_all(self.checkpoint_bg_color, 'a')
        Animation.cancel_all(self.checkpoint_color, 'a')
        self.checkpoint_bg_color.a = 0.7
        self.checkpoint_color.a = 1.0
        bg_anim = (Animation(a=0.7, duration=1.2) +
                   Animation(a=0.0, duration=0.9, t='in_quad'))
        txt_anim = (Animation(a=1.0, duration=1.2) +
                    Animation(a=0.0, duration=0.9, t='in_quad'))
        bg_anim.start(self.checkpoint_bg_color)
        txt_anim.start(self.checkpoint_color)

    def _create_enemy_group(self, pattern_idx, body_color, mark_color):
        egroup = InstructionGroup()
        egroup.add(PushMatrix())
        translate = Translate(0, 0)
        egroup.add(translate)

        egroup.add(Color(*body_color))
        ebody = Ellipse(pos=(-CELL_SIZE / 2, -CELL_SIZE / 2), size=(CELL_SIZE, CELL_SIZE))
        egroup.add(ebody)

        egroup.add(Color(*mark_color))
        emark = Line(circle=(0, 0, 18, 0, 0), width=2)
        egroup.add(emark)

        pattern = DOT_PATTERNS[pattern_idx] if 0 <= pattern_idx < len(DOT_PATTERNS) else []
        edots = []
        for (px, py) in pattern:
            egroup.add(Color(0, 0, 0))
            d = Ellipse(pos=(px - DOT_RAD, py - DOT_RAD), size=(DOT_SIZE, DOT_SIZE))
            egroup.add(d)
            edots.append(d)

        egroup.add(PopMatrix())
        self.dynamic_group.add(egroup)
        return egroup, translate, emark, edots, pattern

    def _apply_enemy_rotation(self, en, dx, dy):
        if   dx == 0 and dy == 1:   fa = 0
        elif dx == 1 and dy == 0:   fa = 90
        elif dx == 0 and dy == -1:  fa = 180
        elif dx == -1 and dy == 0:  fa = 270
        else:                       fa = 0

        if en['turn_rule'] == 'right':
            a_s, a_e = fa + 5, fa + 50
        else:
            a_s, a_e = fa - 50, fa - 5
        en['g_mark'].circle = (0, 0, 18, a_s, a_e)

        pts = en['g_pattern']
        dots = en['g_dots']
        for i in range(len(pts)):
            px, py = pts[i]
            if   dx == 0 and dy == 1:  rx, ry = px, py
            elif dx == 1 and dy == 0:  rx, ry = py, -px
            elif dx == 0 and dy == -1: rx, ry = -px, -py
            elif dx == -1 and dy == 0: rx, ry = -py, px
            else:                      rx, ry = px, py
            dots[i].pos = (rx - DOT_RAD, ry - DOT_RAD)

    def _make_enemy_dict(self, idx, en_state, saved, e_spawn=None):
        dk = self.door_for_enemy.get(idx)
        cid = self.door_color_id.get(dk, 0) if dk is not None else 0
        mark_color = self.color_palette[cid] if self.color_palette else (1, 0, 0)
        body_color = en_state.get('color', WALL_COLOR)
        pattern_idx = en_state.get('pattern_idx', 0)

        egroup, translate, emark, edots, pattern = self._create_enemy_group(
            pattern_idx, body_color, mark_color)

        if saved:
            cur = en_state.get('current_cell', (int(en_state['grid_x']), int(en_state['grid_y'])))
            nxt = tuple(en_state.get('next_cell', cur))
            pixel = Vector(en_state['pixel_x'], en_state['pixel_y'])
            direction = Vector(en_state['dir_x'], en_state['dir_y'])
            last_dir = Vector(en_state['last_dir_x'], en_state['last_dir_y'])
            sleep_counter = int(en_state.get('sleep_counter', 0))
        else:
            ev = Vector(e_spawn[0], e_spawn[1])
            cur = (int(ev.x), int(ev.y))
            nxt = cur
            pixel = ev * TOTAL_STEP
            direction = VEC_ZERO
            last_dir = VEC_ZERO
            sleep_counter = 0

        translate.x = pixel.x + CELL_SIZE / 2
        translate.y = pixel.y + CELL_SIZE / 2

        return {
            'idx': idx,
            'color': body_color,
            'speed': en_state['speed'],
            'pattern_idx': pattern_idx,
            'turn_rule': en_state['turn_rule'],
            'mark_color': mark_color,
            'color_id': cid,
            'grid': Vector(*cur),
            'pixel': pixel,
            'dir': direction,
            'last_dir': last_dir,
            'current_cell': cur,
            'next_cell': nxt,
            'g_group': egroup,
            'g_translate': translate,
            'g_mark': emark,
            'g_dots': edots,
            'g_pattern': pattern,
            'sleep_counter': sleep_counter,
            '_just_moved': False,
