    def _compute_corridor_importance(self):
        N = self.grid_w * self.grid_h
        root = next(iter(self.adj_list.keys()))
        parent = {root: None}
        order, stack = [], [root]
        while stack:
            v = stack.pop()
            order.append(v)
            for u in self.adj_list[v]:
                if u not in parent:
                    parent[u] = v
                    stack.append(u)
        sub = {v: 1 for v in self.adj_list}
        for v in reversed(order):
            p = parent[v]
            if p is not None:
                sub[p] += sub[v]
        importance = {v: 0.0 for v in self.adj_list}
        for v in order:
            p = parent[v]
            if p is not None:
                bw = float(sub[v]) * float(N - sub[v])
                if bw > importance[v]: importance[v] = bw
                if bw > importance[p]: importance[p] = bw
        return importance

    def _assign_door_colors_spatially(self, all_doors, num_colors):
        if num_colors <= 0 or not all_doors:
            return {}
        doors = sorted(all_doors)
        n = len(doors)
        if n == 1:
            return {doors[0]: 0}
        mids = [((a[0] + b[0]) * 0.5, (a[1] + b[1]) * 0.5) for (a, b) in doors]
        order = [0]
        min_d2 = [-1.0] * n
        x0, y0 = mids[0]
        for i in range(n):
            x, y = mids[i]
            dx, dy = x - x0, y - y0
            min_d2[i] = dx * dx + dy * dy
        min_d2[0] = -1.0
        for _ in range(n - 1):
            best_i, best_d = 0, -1.0
            for i in range(n):
                if min_d2[i] > best_d:
                    best_d, best_i = min_d2[i], i
            order.append(best_i)
            bx, by = mids[best_i]
            for i in range(n):
                if min_d2[i] >= 0:
                    x, y = mids[i]
                    dx, dy = x - bx, y - by
                    d = dx * dx + dy * dy
                    if d < min_d2[i]: min_d2[i] = d
            min_d2[best_i] = -1.0
        return {doors[di]: pos % num_colors for pos, di in enumerate(order)}

    def _find_nearest_door(self, start):
        if start in self.underlined_cells:
            return None
        visited = {start}
        q = deque([start])
        while q:
            cur = q.popleft()
            for nxt in self.adj_list[cur]:
                if nxt in visited:
                    continue
                if nxt in self.underlined_cells:
                    return (cur, nxt) if cur < nxt else (nxt, cur)
                visited.add(nxt)
                q.append(nxt)
        return None

    def get_occupied_cells(self, pixel_pos):
        eps = 1e-3
        vx = pixel_pos.x / TOTAL_STEP
        vy = pixel_pos.y / TOTAL_STEP
        return {(math.floor(vx + eps), math.floor(vy + eps)),
                (math.ceil(vx - eps),  math.floor(vy + eps)),
                (math.floor(vx + eps), math.ceil(vy - eps)),
                (math.ceil(vx - eps),  math.ceil(vy - eps))}

    def get_avail(self, x, y):
        return self.cell_avails.get((x, y), [])

    def get_avail_for_color(self, x, y, cid):
        if cid is None:
            return self.cell_avails.get((x, y), [])
        d = self.cell_avails_by_color.get(cid)
        if d is None:
            return self.cell_avails.get((x, y), [])
        return d.get((x, y), [])

    def _has_adjacent_door(self, gx, gy):
        cell = (gx, gy)
        for nb in self.adj_list.get(cell, []):
            key = (cell, nb) if cell < nb else (nb, cell)
            if key in self.doors:
                return True
        return False

    def _compute_intent(self, en, occupied, extra_blocked):
        gx, gy = en['current_cell']
        av_all = self.get_avail_for_color(gx, gy, en.get('color_id'))
        free = []
        for d in av_all:
            tx, ty = gx + int(d.x), gy + int(d.y)
            if (tx, ty) in occupied:
                continue
            if (tx, ty) in extra_blocked:
                continue
            free.append(d)
        if not free:
            return None

        cur_dir = en['dir']
        if cur_dir == VEC_ZERO:
            for pref in (Vector(0, 1), Vector(1, 0), Vector(0, -1), Vector(-1, 0)):
                if pref in free:
                    return (gx + int(pref.x), gy + int(pref.y))
            d = free[0]
            return (gx + int(d.x), gy + int(d.y))

        dx, dy = int(cur_dir.x), int(cur_dir.y)
        right    = Vector(dy, -dx)
        straight = Vector(dx, dy)
        left     = Vector(-dy, dx)
        back     = Vector(-dx, -dy)
        if en['turn_rule'] == 'left':
            priority = (left, straight, right, back)
        else:
            priority = (right, straight, left, back)
        for d in priority:
            if d in free:
                return (gx + int(d.x), gy + int(d.y))
        return None

    def _resolve_enemy_intents(self, active_enemies=None):
        if active_enemies is None:
            active_enemies = self.enemies
        occupied = {en['current_cell'] for en in self.enemies}
        blocked = set()
        intents = {en['idx']: self._compute_intent(en, occupied, blocked)
                   for en in active_enemies}

        for _ in range(30):
            counts = {}
            for v in intents.values():
                if v is not None:
                    counts[v] = counts.get(v, 0) + 1
            disputed = {cell for cell, cnt in counts.items() if cnt > 1}
            newly_blocked = disputed - blocked
            if not newly_blocked:
                break
            blocked |= newly_blocked
            for en in active_enemies:
                if intents[en['idx']] in newly_blocked:
                    intents[en['idx']] = self._compute_intent(en, occupied, blocked)

        counts = {}
        for v in intents.values():
            if v is not None:
                counts[v] = counts.get(v, 0) + 1
        for en in active_enemies:
            v = intents[en['idx']]
            if v is not None and counts.get(v, 0) > 1:
                intents[en['idx']] = None
        return intents

    def get_topological_distances(self, start_grid, targets=None):
        dist = {start_grid: 0}
        q = deque([start_grid])
        t_left = set(targets) if targets else None
        if t_left and start_grid in t_left:
            t_left.remove(start_grid)
            if not t_left: return dist
        while q:
            cur = q.popleft()
            for nxt in self.adj_list[cur]:
                if nxt not in dist:
                    dist[nxt] = dist[cur] + 1
                    q.append(nxt)
                    if t_left and nxt in t_left:
                        t_left.remove(nxt)
                        if not t_left: return dist
        return dist

    def get_player_distances_and_btn(self, start_grid, targets):
        dist = {start_grid: 0}
        q = deque([start_grid])
        t_left = set(targets)
        min_btn = 9999
        touched = self.touched_buttons
        buttons = self.buttons

        if start_grid in buttons and start_grid not in touched:
            min_btn = 0

        t_left.discard(start_grid)
        if not t_left:
            return dist, min_btn

        while q:
            cur = q.popleft()
            d_next = dist[cur] + 1
            for nxt in self.adj_list[cur]:
                if nxt not in dist:
                    dist[nxt] = d_next
                    q.append(nxt)
                    if nxt in buttons and nxt not in touched and d_next < min_btn:
                        min_btn = d_next
                    if nxt in t_left:
                        t_left.discard(nxt)
                        if not t_left:
                            return dist, min_btn
        return dist, min_btn

    def _refresh_player_dists(self):
        targets = {self.hatch_pos}
        for en in self.enemies:
            targets.add(en['current_cell'])
        targets.update(self.buttons.keys())

        self.player_dists, min_btn = self.get_player_distances_and_btn(
            self.player_last_cell, targets)

        if len(self.touched_buttons) >= len(self.buttons):
            d = self.player_dists.get(self.hatch_pos, 9999)
            self.cached_btn_dist = d if d != 9999 else None
        else:
            self.cached_btn_dist = min_btn if min_btn != 9999 else None

    def get_enemy_los(self, en, enemy_positions):
        visible = set()
        ex, ey = en['current_cell']
        edir = en['dir']
        if edir == VEC_ZERO: return visible
        dx, dy = int(edir.x), int(edir.y)
        if dx == 0 and dy == 0: return visible
        ds = 'E' if dx == 1 else 'W' if dx == -1 else 'N' if dy == 1 else 'S'
        cx, cy = ex, ey
        while True:
            if self.maze_data[cy][cx][ds] == 1: break
            nx, ny = cx + dx, cy + dy
            a, b = (cx, cy), (nx, ny)
            key = (a, b) if a < b else (b, a)
            if key in self.doors: break
            cx, cy = nx, ny
            if (cx, cy) in enemy_positions: break
            visible.add((cx, cy))
        return visible

