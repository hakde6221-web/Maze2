class MazeGeneratorBase:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.grid = None
        self.p_spawn = None
        self.e_spawns = {}
        self.dead_ends = None
        self.dead_end_positions = {}
        self.target_de = 0
        self.buttons = {}

    def _bfs(self, start):
        dist = {start: 0}
        parent = {start: None}
        q = deque([start])
        while q:
            ccx, ccy = q.popleft()
            for d, (dx, dy) in DIRS.items():
                if self.grid[ccy][ccx][d] == 0:
                    nxt = (ccx + dx, ccy + dy)
                    if nxt not in dist:
                        dist[nxt] = dist[(ccx, ccy)] + 1
                        parent[nxt] = (ccx, ccy)
                        q.append(nxt)
        return dist, parent

    def _bfs_nearest_dead_end(self, start, dead_ends_set):
        dist = {start: 0}
        q = deque([start])
        while q:
            cx, cy = q.popleft()
            cur = (cx, cy)
            if cur != start and cur in dead_ends_set:
                return cur, dist[cur]
            for d, (dx, dy) in DIRS.items():
                if self.grid[cy][cx][d] == 0:
                    nxt = (cx + dx, cy + dy)
                    if nxt not in dist:
                        dist[nxt] = dist[cur] + 1
                        q.append(nxt)
        return None, None

    def _find_topological_center(self):
        dists1, _ = self._bfs((0, 0))
        n1 = max(dists1, key=dists1.get)
        dists2, parent2 = self._bfs(n1)
        n2 = max(dists2, key=dists2.get)
        path, curr = [], n2
        while curr is not None:
            path.append(curr)
            curr = parent2.get(curr)
        center = path[len(path) // 2]
        cd, _ = self._bfs(center)
        return center, cd

    def _compute_btn_pos(self, b_pos):
        bx, by = b_pos
        px, py = bx * TOTAL_STEP, by * TOTAL_STEP
        cell = self.grid[by][bx]
        open_dir = next((d for d in DIRS if cell[d] == 0), 'N')
        if open_dir == 'N':   return px + CELL_SIZE / 2, py, 270, 450
        if open_dir == 'S':   return px + CELL_SIZE / 2, py + CELL_SIZE, 90, 270
        if open_dir == 'E':   return px, py + CELL_SIZE / 2, 0, 180
        if open_dir == 'W':   return px + CELL_SIZE, py + CELL_SIZE / 2, 180, 360
        return px + CELL_SIZE / 2, py + CELL_SIZE / 2, 0, 360

    def _generate_growing_tree(self, p):
        grid = [[{'N': 1, 'S': 1, 'E': 1, 'W': 1} for _ in range(self.w)] for _ in range(self.h)]
        visited = [[False] * self.w for _ in range(self.h)]
        sx, sy = random.randint(0, self.w - 1), random.randint(0, self.h - 1)
        active = [(sx, sy)]
        visited[sy][sx] = True
        while active:
            idx = -1 if random.random() < p else random.randint(0, len(active) - 1)
            cx, cy = active[idx]
            neighbors = []
            for d, (dx, dy) in DIRS.items():
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < self.w and 0 <= ny < self.h and not visited[ny][nx]:
                    neighbors.append((nx, ny, d))
            if neighbors:
                nx, ny, d = random.choice(neighbors)
                grid[cy][cx][d] = 0
                grid[ny][nx][INV_DIRS[d]] = 0
                visited[ny][nx] = True
                active.append((nx, ny))
            else:
                active.pop(idx)
        return grid

    def _setup_standard_spawns(self, dists_from_center, num_enemies, p_spawn):
        valid_des = list(self.dead_ends)
        de_dists = {de: dists_from_center.get(de, 0) for de in valid_des}
        for i in range(num_enemies):
            if not de_dists:
                break
            best = max(de_dists, key=de_dists.get)
            self.e_spawns[i] = best
            del de_dists[best]
            new_dists, _ = self._bfs(best)
            for node in de_dists:
                de_dists[node] = min(de_dists[node], new_dists.get(node, 999999))

    def _count_de(self, g):
        return sum(1 for y in range(self.h) for x in range(self.w)
                   if list(g[y][x].values()).count(1) == 3)


class MazeGenerator20(MazeGeneratorBase):
    def __init__(self, w=MAZE_W, h=MAZE_H, target_de=NUM_DEAD_ENDS):
        super().__init__(w, h)
        self.target_de = target_de
        self.grid = self._generate_base_grid()
        self.dead_ends = [(x, y) for y in range(self.h) for x in range(self.w)
                          if list(self.grid[y][x].values()).count(1) == 3]
        self.p_spawn, cd = self._find_topological_center()
        self._setup_standard_spawns(cd, NUM_ENEMIES, self.p_spawn)
        self.dead_end_positions = {b: self._compute_btn_pos(b) for b in self.dead_ends}
        for b_pos in set(self.e_spawns.values()):
            bcx, bcy, astart, aend = self.dead_end_positions[b_pos]
            self.buttons[b_pos] = {'pos': b_pos, 'bcx': bcx, 'bcy': bcy,
                                   'astart': astart, 'aend': aend,
                                   'type': 'green', 'collectible': True}

    def _generate_base_grid(self):
        p = 0.5
        temp = None
        for attempt in range(3000):
            temp = self._generate_growing_tree(p)
            count = self._count_de(temp)
            if count == self.target_de:
                return temp
            p = min(0.999, p + 0.004) if count > self.target_de else max(0.001, p - 0.004)
            if attempt % 200 == 199:
                p = random.uniform(0.05, 0.95)
        return temp


class MazeGeneratorLarge(MazeGeneratorBase):
    def __init__(self, w=50, h=50, target_min=625, target_max=690, num_enemies=100):
        super().__init__(w, h)
        self.target_min, self.target_max = target_min, target_max
        while True:
            self.grid = self._generate_base_grid()
            self.dead_ends = [(x, y) for y in range(self.h) for x in range(self.w)
                              if list(self.grid[y][x].values()).count(1) == 3]
            if self.target_min <= len(self.dead_ends) <= self.target_max:
                self.target_de = len(self.dead_ends)
                break
        self.p_spawn, cd = self._find_topological_center()
        self._setup_standard_spawns(cd, num_enemies, self.p_spawn)
        self.dead_end_positions = {b: self._compute_btn_pos(b) for b in self.dead_ends}
        for b_pos in set(self.e_spawns.values()):
            bcx, bcy, astart, aend = self.dead_end_positions[b_pos]
            self.buttons[b_pos] = {'pos': b_pos, 'bcx': bcx, 'bcy': bcy,
                                   'astart': astart, 'aend': aend,
                                   'type': 'green', 'collectible': True}

    def _generate_base_grid(self):
        p = 0.5
        while True:
            temp = self._generate_growing_tree(p)
            count = self._count_de(temp)
            if self.target_min <= count <= self.target_max:
                return temp
            p = min(0.99, p + 0.02) if count > self.target_max else max(0.01, p - 0.02)


