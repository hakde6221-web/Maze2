    def _draw_trophy_board(self, trophy_top_y, icon_r, group=None):
        if group is None:
            group = self.hud_static_group
        trophy_cell = icon_r * TROPHY_CELL_MULT
        trophy_gap = icon_r * TROPHY_GAP_MULT
        board_w = 5 * trophy_cell + 4 * trophy_gap
        base_x = (self.width - board_w) / 2.0
        trophy_y = trophy_top_y - trophy_cell
