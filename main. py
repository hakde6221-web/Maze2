            x = base_x + i * (trophy_cell + trophy_gap)
            scx = x + trophy_cell / 2
            scy = trophy_y + trophy_cell / 2
            if i < len(self.collected_trophies):
                cid = self.collected_trophies[i]
                rgb = self.color_palette[cid] if 0 <= cid < len(self.color_palette) else (0.5, 0.5, 0.5)
                _draw_star(group, scx, scy, trophy_cell, rgb)
            else:
                _draw_star_outline(group, scx, scy, trophy_cell,
                                   (*TEXT_COLOR, 0.7))

