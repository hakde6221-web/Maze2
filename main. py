    def _update_hud_state(self):
        static_cur = (self.level, self.num_doors, tuple(self.collected_trophies))
        if getattr(self, 'hud_static_state', None) != static_cur:
            self.hud_static_state = static_cur
            self.draw_hud_static()

        self._update_hud_fps()

        dyn_cur = (self.full_sleep_cycles, self._get_slept_pct())
        if getattr(self, 'hud_dynamic_state', None) != dyn_cur:
            self.hud_dynamic_state = dyn_cur
            self.draw_hud_dynamic()

        min_d, min_enemies = 9999, []
        for en in self.enemies:
            d = self.player_dists.get(en['current_cell'], 9999)
            if d < min_d:
                min_d, min_enemies = d, [en]
            elif d == min_d:
                min_enemies.append(en)
        target_en = min_enemies[0] if len(min_enemies) == 1 else None

        btn_dist = None
        btn_color = None
        show_hatch = False
        carrier_idx = None
        if self.hatch_open:
            d = self.player_dists.get(self.hatch_pos, 9999)
            if d < 9999:
                btn_dist = d
            show_hatch = True
        elif self.ground_buttons:
            min_bd, min_bc, tied = 9999, None, False
            for pos, cid in self.ground_buttons.items():
                d = self.player_dists.get(pos, 9999)
                if d < min_bd:
                    min_bd, min_bc, tied = d, cid, False
                elif d == min_bd:
                    tied = True
            if min_bd < 9999 and not tied:
                btn_dist = min_bd
                btn_color = min_bc
        else:
            min_cd, min_ces, tied = 9999, [], False
            for en in self.enemies:
                if not en.get('is_carrier', False):
                    continue
                d = self.player_dists.get(en['current_cell'], 9999)
                if d < min_cd:
                    min_cd, min_ces, tied = d, [en], False
                elif d == min_cd:
                    tied = True
            if min_cd < 9999:
                btn_dist = min_cd
                if not tied and min_ces:
                    carrier_idx = min_ces[0]['idx']

        r_btn = _round_hud_dist(btn_dist)
        r_min = _round_hud_dist(min_d)
        extra_cur = (r_btn, btn_color, show_hatch, carrier_idx, r_min,
                     target_en['idx'] if target_en else None)
        if getattr(self, 'hud_extra_state', None) != extra_cur:
            self.hud_extra_state = extra_cur
