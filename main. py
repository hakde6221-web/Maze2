def _get_save_dir():
    global SAVE_DIR
    if SAVE_DIR is None:
        try:
            app = App.get_running_app()
            if app is not None and getattr(app, 'user_data_dir', None):
                SAVE_DIR = app.user_data_dir
        except Exception:
            pass
        if SAVE_DIR is None:
            SAVE_DIR = os.path.dirname(os.path.abspath(__file__))
        try:
            os.makedirs(SAVE_DIR, exist_ok=True)
        except OSError:
            pass
    return SAVE_DIR


def get_map_file():
    return os.path.join(_get_save_dir(), _MAP_FILES[CURRENT_MODE])


def get_save_prefix():
    return _SAVE_PREFIXES[CURRENT_MODE]


def get_save_files():
    prefix = get_save_prefix()
    files = []
    try:
        for f in os.listdir(_get_save_dir()):
            if f.startswith(prefix) and f.endswith(SAVE_EXT):
                try:
                    files.append((int(f[len(prefix):-len(SAVE_EXT)]), f))
                except ValueError:
                    pass
    except OSError:
        pass
    return sorted(files)


def get_latest_save_path():
    files = get_save_files()
    return os.path.join(_get_save_dir(), files[-1][1]) if files else None


def get_second_latest_save_path():
    files = get_save_files()
    if len(files) < 2:
        return None
    return os.path.join(_get_save_dir(), files[-2][1])


def has_any_save():
    return len(get_save_files()) > 0


def create_new_save_path():
    files = get_save_files()
    next_num = (files[-1][0] + 1) if files else 1
    return os.path.join(_get_save_dir(), f"{get_save_prefix()}{next_num:04d}{SAVE_EXT}")


def cleanup_old_saves(keep=2):
    files = get_save_files()
    if len(files) <= keep:
        return
    for _, f in files[:-keep]:
        try:
            os.remove(os.path.join(_get_save_dir(), f))
        except OSError:
            pass


def cleanup_except(keep_paths):
    keep_set = set(keep_paths)
    for _, f in get_save_files():
        full = os.path.join(_get_save_dir(), f)
        if full not in keep_set:
            try:
                os.remove(full)
            except OSError:
                pass


def delete_all_saves():
    for _, f in get_save_files():
        try:
            os.remove(os.path.join(_get_save_dir(), f))
        except OSError:
            pass


def _generate_dot_patterns():
    perms = [
        [2, 1, 0, 5, 4, 3, 8, 7, 6],
        [6, 7, 8, 3, 4, 5, 0, 1, 2],
        [0, 3, 6, 1, 4, 7, 2, 5, 8],
        [8, 5, 2, 7, 4, 1, 6, 3, 0],
        [8, 7, 6, 5, 4, 3, 2, 1, 0],
        [6, 3, 0, 7, 4, 1, 8, 5, 2],
        [2, 5, 8, 1, 4, 7, 0, 3, 6],
    ]

    def apply(mask, perm):
        r = 0
        for i in range(9):
            if (mask >> i) & 1:
                r |= 1 << perm[i]
        return r

    def orbit(mask):
        result = set()
        cur = mask
        for _ in range(4):
            result.add(cur)
            result.add(apply(cur, perms[0]))
            cur = apply(cur, perms[5])
        return result

    symmetric, asymmetric = [], []
    for mask in range(512):
        if apply(mask, perms[0]) == mask:
            symmetric.append(mask)
            continue
        if any(apply(mask, p) == mask for p in perms[1:]):
            continue
        if mask == min(orbit(mask)):
            asymmetric.append(mask)
    return symmetric, asymmetric


def _mask_to_positions(mask):
    pts = []
    for i in range(9):
        if (mask >> i) & 1:
            col = i % 3
            row = i // 3
            x = (col - 1) * 8
            y = (1 - row) * 8
            pts.append((x, y))
    return pts


