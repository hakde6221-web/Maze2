        self.hatch_open = False
        self.touched_buttons = set()

        if save_data:
            self.touched_buttons = save_data.get('touched_buttons', set())
            self.hatch_open = save_data['hatch_open']
            self.player_grid = Vector(save_data['player_grid_x'], save_data['player_grid_y'])
            self.p_pixel = Vector(save_data['p_pixel_x'], save_data['p_pixel_y'])
            self.p_dir = Vector(save_data['p_dir_x'], save_data['p_dir_y'])
            self.last_p_dir = Vector(save_data['last_p_dir_x'], save_data['last_p_dir_y'])
            for es in save_data['enemies']:
                self.enemies.append(self._make_enemy_dict(es['idx'], es, saved=True))
            self.sleep_cycle_set = set(save_data.get('sleep_cycle_set',
                                                      set(e['idx'] for e in self.enemies)))
        else:
            self.player_grid = Vector(p_spawn[0], p_spawn[1])
            self.p_pixel = self.player_grid * TOTAL_STEP
            self.p_dir = VEC_ZERO
            self.last_p_dir = Vector(0, 1)

            for slot_idx, (_, e_spawn) in enumerate(sorted(e_spawns.items())):
                if slot_idx >= self._max_enemies:
                    break
                pat_idx = self._pattern_pool[slot_idx % len(self._pattern_pool)]
                rule = 'right' if slot_idx % 2 == 0 else 'left'
                prof = {'pattern_idx': pat_idx, 'turn_rule': rule,
                        'speed': 0.5, 'color': WALL_COLOR}
                self.enemies.append(self._make_enemy_dict(
                    slot_idx, prof, saved=False, e_spawn=e_spawn))

            self.sleep_cycle_set = set(e['idx'] for e in self.enemies)

        cc = [0] * self.num_colors
        for en in self.enemies:
            cid = en.get('color_id', 0)
            if 0 <= cid < self.num_colors:
                cc[cid] += 1
        self._color_counts_tuple = tuple(cc)

        ref_speed = self.enemies[0]['speed'] if self.enemies else 0.5
        self.enemy_step_interval = TOTAL_STEP / (ref_speed * 60.0)
        self.enemy_time = save_data.get('enemy_time', 0.0) if save_data else self.enemy_step_interval
        self.enemy_tick_counter = 0
        self.next_dir = None
        self.player_last_cell = (int(self.player_grid.x), int(self.player_grid.y))
        self._refresh_player_dists()

        if not self.hatch_open and len(self.touched_buttons) >= len(self.buttons) \
                and len(self.buttons) > 0:
            self.hatch_open = True

        self.current_joy_dir = None
        self.last_p_cells = self.get_occupied_cells(self.p_pixel)
        self.interactive_redraw_needed = False

        self.bind(size=self.trigger_static_redraw, pos=self.trigger_static_redraw)
        self._update_event = Clock.schedule_interval(self.update, 1 / 60.0)

    def update_transforms(self):
        sw, sh = self.width, self.height
        if sw <= 0 or sh <= 0:
            return

        f_size = max(14, int(sw / 40))
        row_h = int(f_size * 1.8)
        hud_h = row_h * 4

        maze_size = sw
        maze_top = sh - hud_h
        maze_bottom = maze_top - maze_size

        if maze_bottom < MIN_JOY_SIZE:
            maze_size = max(MIN_JOY_SIZE, sh - hud_h - MIN_JOY_SIZE)
            maze_size = min(maze_size, sw)
            maze_top = sh - hud_h
            maze_bottom = maze_top - maze_size

        self.f_size = f_size
        self.row_h = row_h
        self.hud_h = hud_h
        self.maze_size = maze_size
        self.maze_top = maze_top
        self.maze_bottom = maze_bottom

        dim = 9 * TOTAL_STEP
        self.maze_scale = maze_size / dim
        self.maze_cx = sw / 2.0
        self.maze_center_y = maze_bottom + maze_size / 2.0

        maze_left = (sw - maze_size) / 2.0
        self.stencil_rect1.pos = (maze_left, maze_bottom)
        self.stencil_rect1.size = (maze_size, maze_size)
        self.stencil_rect2.pos = (maze_left, maze_bottom)
        self.stencil_rect2.size = (maze_size, maze_size)

    def update_camera(self):
        self.matrix_group.clear()
        self.matrix_group.add(Translate(self.maze_cx, self.maze_center_y, 0))
        self.matrix_group.add(Scale(self.maze_scale, self.maze_scale, 1))
        self.matrix_group.add(Translate(-self.p_pixel.x - CELL_SIZE / 2,
                                        -self.p_pixel.y - CELL_SIZE / 2, 0))

    def trigger_static_redraw(self, *args):
        self.update_transforms()
        self.draw_level()
        self.last_drawn_chunk = (int(self.player_grid.x), int(self.player_grid.y))
        self.draw_static(*self.last_drawn_chunk)
        self.draw_interactive(*self.last_drawn_chunk)
        self.draw_doors(*self.last_drawn_chunk)
        self.update_camera()
        self.draw_entities(*self.last_drawn_chunk)
        self.hud_state = None
        self._update_hud_state()
        _schedule_canvas_refresh()

    def draw_level(self):
        self.level_group.clear()
        if not hasattr(self, 'maze_top'): return
        tex = get_text_texture(f"Level-{self.level}", 26)
        tx = (self.width - tex.size[0]) / 2
        ty = self.maze_top + self.hud_h - tex.size[1] - 5
        self.level_group.add(Color(1, 1, 0, 1))
        self.level_group.add(Rectangle(texture=tex, pos=(tx, ty), size=tex.size))

    def draw_static(self, px, py):
        self.static_group.clear()
        self.static_group.add(Color(0.05, 0.05, 0.05))
        self.static_group.add(Rectangle(size=(self.grid_w * TOTAL_STEP, self.grid_h * TOTAL_STEP), pos=(0, 0)))
        min_y, max_y = max(0, py - 5), min(self.grid_h, py + 6)
        min_x, max_x = max(0, px - 5), min(self.grid_w, px + 6)

        self.static_group.add(Color(*WALL_COLOR))
        for y in range(min_y, max_y):
            for x in range(min_x, max_x):
                m, cx, cy = self.maze_data[y][x], x * TOTAL_STEP, y * TOTAL_STEP
                if m['N'] and y != self.grid_h - 1:
                    self.static_group.add(Rectangle(pos=(cx - WALL_THICK, cy + CELL_SIZE),
                                                    size=(TOTAL_STEP + WALL_THICK, WALL_THICK)))
                if m['S'] and y != 0:
                    self.static_group.add(Rectangle(pos=(cx - WALL_THICK, cy - WALL_THICK),
                                                    size=(TOTAL_STEP + WALL_THICK, WALL_THICK)))
                if m['E'] and x != self.grid_w - 1:
                    self.static_group.add(Rectangle(pos=(cx + CELL_SIZE, cy - WALL_THICK),
                                                    size=(WALL_THICK, TOTAL_STEP + WALL_THICK)))
                if m['W'] and x != 0:
                    self.static_group.add(Rectangle(pos=(cx - WALL_THICK, cy - WALL_THICK),
                                                    size=(WALL_THICK, TOTAL_STEP + WALL_THICK)))

        self.static_group.add(Color(1, 0, 0))
        for y in range(min_y, max_y):
            for x in range(min_x, max_x):
                m, cx, cy = self.maze_data[y][x], x * TOTAL_STEP, y * TOTAL_STEP
                if m['N'] and y == self.grid_h - 1:
                    self.static_group.add(Rectangle(pos=(cx - WALL_THICK, cy + CELL_SIZE),
                                                    size=(TOTAL_STEP + WALL_THICK, WALL_THICK)))
                if m['S'] and y == 0:
                    self.static_group.add(Rectangle(pos=(cx - WALL_THICK, cy - WALL_THICK),
                                                    size=(TOTAL_STEP + WALL_THICK, WALL_THICK)))
                if m['E'] and x == self.grid_w - 1:
                    self.static_group.add(Rectangle(pos=(cx + CELL_SIZE, cy - WALL_THICK),
                                                    size=(WALL_THICK, TOTAL_STEP + WALL_THICK)))
                if m['W'] and x == 0:
                    self.static_group.add(Rectangle(pos=(cx - WALL_THICK, cy - WALL_THICK),
                                                    size=(WALL_THICK, TOTAL_STEP + WALL_THICK)))

    def draw_doors(self, px, py):
        self.doors_group.clear()
        DOOR_W = WALL_THICK / 3.0
        half = CELL_SIZE / 2.0
        if not self.color_palette: return
        for (a, b) in self.doors:
            mx, my = (a[0] + b[0]) * 0.5, (a[1] + b[1]) * 0.5
            if abs(mx - px) > 6 or abs(my - py) > 6: continue
            cid = self.door_color_id.get((a, b))
            if cid is None: continue
            r, g, bl = self.color_palette[cid]
            self.doors_group.add(Color(r, g, bl, 1.0))
            cx = mx * TOTAL_STEP + CELL_SIZE / 2.0
            cy = my * TOTAL_STEP + CELL_SIZE / 2.0
            if a[0] != b[0]:
                self.doors_group.add(Rectangle(pos=(cx - DOOR_W / 2, cy - half),
                                               size=(DOOR_W, half * 2)))
            else:
                self.doors_group.add(Rectangle(pos=(cx - half, cy - DOOR_W / 2),
                                               size=(half * 2, DOOR_W)))

    def draw_interactive(self, px, py):
        self.interactive_group.clear()
        hx, hy = self.hatch_pos
        if abs(hx - px) <= 5 and abs(hy - py) <= 5:
            hx_px, hy_px = hx * TOTAL_STEP, hy * TOTAL_STEP
            hs = CELL_SIZE * 0.9
            off = (CELL_SIZE - hs) / 2
            cx, cy = hx_px + CELL_SIZE / 2, hy_px + CELL_SIZE / 2
            r = hs / 2
            if not self.hatch_open:
                self.interactive_group.add(Color(0.4, 0.4, 0.4, 0.6))
                self.interactive_group.add(Ellipse(pos=(hx_px + off, hy_px + off), size=(hs, hs)))
                self.interactive_group.add(Color(0.2, 0.2, 0.2, 0.8))
                self.interactive_group.add(Line(circle=(cx, cy, r), width=1.5))
                c45 = math.cos(math.radians(45)) * r
                self.interactive_group.add(Line(points=[cx - c45, cy - c45, cx + c45, cy + c45], width=1.5))
                self.interactive_group.add(Line(points=[cx - c45, cy + c45, cx + c45, cy - c45], width=1.5))
            else:
                self.interactive_group.add(Color(0.05, 0.05, 0.05, 0.6))
                self.interactive_group.add(Ellipse(pos=(hx_px + off, hy_px + off), size=(hs, hs)))
                self.interactive_group.add(Color(0, 1, 0.5, 0.8))
                self.interactive_group.add(Line(circle=(cx, cy, r), width=1.5))

        for btn in self.buttons.values():
            if abs(btn['pos'][0] - px) <= 5 and abs(btn['pos'][1] - py) <= 5:
                bcx, bcy, astart, aend = btn['bcx'], btn['bcy'], btn['astart'], btn['aend']
                color = WALL_COLOR if btn['pos'] in self.touched_buttons else GREEN_BUTTON_COLOR
                self.interactive_group.add(Color(*color))
                self.interactive_group.add(Ellipse(pos=(bcx - BTN_R, bcy - BTN_R),
                                                   size=(BTN_R * 2, BTN_R * 2),
                                                   angle_start=astart, angle_end=aend))

    def draw_entities(self, gx, gy):
        self._draw_player_eyes()
        progress = 1.0
        if self.enemy_step_interval > 0:
            progress = max(0.0, min(1.0, self.enemy_time / self.enemy_step_interval))

        for en in self.enemies:
            ccx, ccy = en['current_cell']
            ncx, ncy = en['next_cell']
            vcx = ccx + (ncx - ccx) * progress
            vcy = ccy + (ncy - ccy) * progress
            if abs(vcx - gx) > ENEMY_VIS_RADIUS or abs(vcy - gy) > ENEMY_VIS_RADIUS:
                if en.get('is_visible', True):
                    self.dynamic_group.remove(en['g_group'])
                    en['is_visible'] = False
                continue
            if not en.get('is_visible', True):
                self.dynamic_group.add(en['g_group'])
                en['is_visible'] = True

            ex = ccx * TOTAL_STEP + (ncx - ccx) * TOTAL_STEP * progress
            ey = ccy * TOTAL_STEP + (ncy - ccy) * TOTAL_STEP * progress
            en['pixel'] = Vector(ex, ey)
            ecx, ecy = ex + CELL_SIZE / 2, ey + CELL_SIZE / 2

            en['g_translate'].x = ecx
            en['g_translate'].y = ecy

            dx, dy = en['dir'].x, en['dir'].y
            if (dx, dy) != en['last_drawn_dir']:
                en['last_drawn_dir'] = (dx, dy)
                self._apply_enemy_rotation(en, dx, dy)

    def _draw_hud_enemy(self, en, cx, cy, scale=1.0):
        r = (CELL_SIZE * scale) / 2
        c = en['color']
        self.ui_group.add(Color(*c))
        self.ui_group.add(Ellipse(pos=(cx - r, cy - r), size=(CELL_SIZE * scale, CELL_SIZE * scale)))
        dx, dy = en.get('dir', Vector(0, -1)).x, en.get('dir', Vector(0, -1)).y
        if   dx == 0 and dy == 1:   fa = 0
        elif dx == 1 and dy == 0:   fa = 90
        elif dx == 0 and dy == -1:  fa = 180
        elif dx == -1 and dy == 0:  fa = 270
        else:                       fa = 180
        if en['turn_rule'] == 'right':
            a_s, a_e = fa + 5, fa + 50
        else:
            a_s, a_e = fa - 50, fa - 5
        mc = en.get('mark_color', (0, 0, 0))
        self.ui_group.add(Color(*mc))
        self.ui_group.add(Line(circle=(cx, cy, 18 * scale, a_s, a_e), width=2 * scale))
        pts = DOT_PATTERNS[en['pattern_idx']] if 0 <= en['pattern_idx'] < len(DOT_PATTERNS) else []
        rad, dsz = 3 * scale, 6 * scale
        for i, (px, py) in enumerate(pts):
            if   dx == 0 and dy == 1:  rx, ry = px, py
            elif dx == 1 and dy == 0:  rx, ry = py, -px
            elif dx == 0 and dy == -1: rx, ry = -px, -py
            elif dx == -1 and dy == 0: rx, ry = -py, px
            else:                      rx, ry = px, py
            rx *= scale; ry *= scale
            self.ui_group.add(Color(0, 0, 0))
            self.ui_group.add(Ellipse(pos=(cx + rx - rad, cy + ry - rad), size=(dsz, dsz)))

    def draw_hud(self, state, target_en):
        self.ui_group.clear()
        if not hasattr(self, 'maze_top'): return

        maze_top = self.maze_top
        maze_size = self.maze_size
        f_size = self.f_size
        row_h = self.row_h

        lw = 1.0
        self.ui_group.add(Color(1, 0.4, 0.7, 1))
        self.ui_group.add(Line(rectangle=(lw, self.maze_bottom + lw,
                                          maze_size - lw * 2, maze_size - lw * 2), width=lw))

        r = f_size * 0.55

        y1 = maze_top + row_h * 0.5
        y2 = maze_top + row_h * 1.5
        y3 = maze_top + row_h * 2.5
        y4 = maze_top + row_h * 3.5

        c1x = max(10, self.width * 0.05)
        r_s = min(r * 0.9, row_h * 0.4)
        self.ui_group.add(Color(*GREEN_BUTTON_COLOR))
        self.ui_group.add(Ellipse(pos=(c1x, y1 - r_s), size=(r_s * 2, r_s * 2),
                                  angle_start=270, angle_end=450))
        cx_txt = c1x + r_s * 2 + 8
        w = self._draw_text(f"{state['score']}/{len(self.buttons)}", cx_txt, y1, f_size)
        cx_txt += w + 8
        w = self._draw_text("|", cx_txt, y1, f_size)
        cx_txt += w + 8
        if state.get('btn_dist') is not None:
            self._draw_text(str(state['btn_dist']), cx_txt, y1, f_size)

        c2x = self.width * 0.42
        icon_r = min(r, row_h * 0.4)
        self.ui_group.add(Color(0, 1, 0.5))
        self.ui_group.add(Ellipse(pos=(c2x, y1 - icon_r), size=(icon_r * 2, icon_r * 2)))
        self.ui_group.add(Color(0, 0, 0))
        self.ui_group.add(Ellipse(pos=(c2x + icon_r * 0.2, y1 + icon_r * 0.1),
                                  size=(icon_r * 0.15, icon_r * 0.15)))
        self.ui_group.add(Ellipse(pos=(c2x + icon_r * 0.65, y1 + icon_r * 0.1),
                                  size=(icon_r * 0.15, icon_r * 0.15)))
        cx_t = c2x + icon_r * 2 + 6
        max_icon_r = row_h * 0.38
        sc = min(self.maze_scale * 0.5, max_icon_r * 2.0 / CELL_SIZE)
        if target_en:
            self._draw_hud_enemy(target_en, cx_t + icon_r, y1, scale=sc)
        cx_t += icon_r * 2 + 6
        val_str = f"{state['dist_val']}" if state['dist_val'] < 9999 else "-"
        self._draw_text(val_str, cx_t, y1, f_size)

        c3x = self.width * 0.78
        fps_str = f"FPS {state['fps']}"
        self._draw_text(fps_str, c3x, y1, f_size)

        cc = state.get('color_counts', ())
        dc = state.get('door_counts', ())
        total_enemies = sum(cc)
        x_pos = 15
        x_pos = self._draw_labeled_colored(
            "Enemies:", total_enemies, cc, self.color_palette, x_pos, y2, f_size)

        x_pos = 15
        x_pos = self._draw_labeled_colored(
            "Doors:", state.get('num_doors', 0), dc, self.color_palette, x_pos, y3, f_size)

        x_pos = 15
        w = self._draw_text("Ends:", x_pos, y4, f_size); x_pos += w + 6
        self._draw_text(str(self.target_de), x_pos, y4, f_size)

    def _update_hud_state(self):
        min_d, min_enemies = 9999, []
        for en in self.enemies:
            d = self.player_dists.get(en['current_cell'], 9999)
            if d < min_d:
                min_d, min_enemies = d, [en]
            elif d == min_d:
                min_enemies.append(en)
        target_en = min_enemies[0] if len(min_enemies) == 1 else None

        btn_dist = self.cached_btn_dist

        cur = {'score': len(self.touched_buttons), 'dist_val': min_d,
               'target_en_idx': target_en['idx'] if target_en else None,
               'tick': self.enemy_tick_counter, 'num_doors': self.num_doors,
               'color_counts': self._color_counts_tuple,
               'door_counts': self._door_counts_tuple,
               'btn_dist': btn_dist}
        if getattr(self, 'hud_state', None) != cur:
            self.hud_state = cur
            st = dict(cur); st['fps'] = int(Clock.get_fps())
            self.draw_hud(st, target_en)


class MazeJoystick(Widget):
    def __init__(self, game, **kwargs):
        super().__init__(**kwargs)
        self.game = game
        self.active_sector = None
        self.snd_click = SoundLoader.load(SND_JOY_PATH)
        self.sectors = [{'v': (0, 1), 's': 315, 'e': 405}, {'v': (1, 0), 's': 45, 'e': 135},
                        {'v': (0, -1), 's': 135, 'e': 225}, {'v': (-1, 0), 's': 225, 'e': 315}]
        self.bind(pos=self.redraw, size=self.redraw)

    def collide_point(self, x, y):
        cx = self.x + self.width / 2.0
        cy = self.y + self.height / 2.0
        r = min(self.width, self.height) / 2.0
        dx = x - cx
        dy = y - cy
        return dx * dx + dy * dy <= r * r

    def redraw(self, *args):
        self.canvas.clear()
        cx, cy = self.x + self.width / 2.0, self.y + self.height / 2.0
        max_r = min(self.width, self.height) / 2.0
        if max_r <= 0: return
        ot = max(4, max_r * 0.05)
        r = max_r - ot / 2.0
        with self.canvas:
            Color(*WALL_COLOR)
            Ellipse(pos=(cx - r - ot / 2, cy - r - ot / 2), size=(r * 2 + ot, r * 2 + ot))
            Color(0.15, 0.15, 0.15)
            Ellipse(pos=(cx - r, cy - r), size=(r * 2, r * 2))
            for i, s in enumerate(self.sectors):
                Color(*(0, 1, 1, 1) if i == self.active_sector else (0.25, 0.25, 0.25, 1))
                Ellipse(pos=(cx - r * 0.95, cy - r * 0.95), size=(r * 1.9, r * 1.9),
                        angle_start=s['s'], angle_end=s['e'])
            Color(*WALL_COLOR)
            for angle in (45, 135):
                rad = math.radians(angle)
                dx, dy = math.cos(rad) * r * 0.95, math.sin(rad) * r * 0.95
                Line(points=[cx - dx, cy - dy, cx + dx, cy + dy], width=max(2, ot / 2))
            Color(0.1, 0.1, 0.1)
            Ellipse(pos=(cx - r * 0.2, cy - r * 0.2), size=(r * 0.4, r * 0.4))

    def on_touch_down(self, t):
        if self.collide_point(*t.pos):
            self.handle(t); return True

    def on_touch_move(self, t):
        if self.collide_point(*t.pos):
            self.handle(t); return True

    def on_touch_up(self, t):
        if self.active_sector is not None:
            self.active_sector = None
            self.game.current_joy_dir = None
            self.redraw()

    def handle(self, t):
        cx, cy = self.x + self.width / 2.0, self.y + self.height / 2.0
        r = min(self.width, self.height) / 2.0
        dx, dy = t.x - cx, t.y - cy
        if dx * dx + dy * dy < (r * 0.15) ** 2:
            return
        a = math.degrees(math.atan2(dx, dy)) % 360
        idx = 0 if (315 <= a or a < 45) else 1 if 45 <= a < 135 else 2 if 135 <= a < 225 else 3
        self.game.current_joy_dir = Vector(self.sectors[idx]['v'])
        if self.active_sector != idx:
            self.active_sector = idx
            if self.snd_click and not App.get_running_app().is_muted: self.snd_click.play()
            self.game.next_dir = Vector(self.sectors[idx]['v'])
            self.redraw()


class MuteButton(Widget):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.bind(pos=self.redraw, size=self.redraw)

    def redraw(self, *args):
        self.canvas.clear()
        if self.width <= 0: return
        app = App.get_running_app()
        cx, cy, r = self.x + self.width / 2, self.y + self.height / 2, self.width / 2
        with self.canvas:
            Color(*WALL_COLOR); Ellipse(pos=(self.x, self.y), size=(self.width, self.height))
            Color(0.15, 0.15, 0.15)
            ot = max(3, self.width * 0.08)
            Ellipse(pos=(self.x + ot / 2, self.y + ot / 2), size=(self.width - ot, self.height - ot))
            Color(1, 1, 1)
            Rectangle(pos=(cx - r * 0.4, cy - r * 0.15), size=(r * 0.2, r * 0.3))
            Quad(points=[cx - r * 0.2, cy - r * 0.15, cx + r * 0.2, cy - r * 0.4,
                         cx + r * 0.2, cy + r * 0.4, cx - r * 0.2, cy + r * 0.15])
            if not getattr(app, 'is_muted', False):
                Line(circle=(cx - r * 0.1, cy, r * 0.35, -50, 50), width=2)
                Line(circle=(cx - r * 0.1, cy, r * 0.55, -50, 50), width=2)
            else:
                Color(1, 0, 0)
                Line(points=[cx - r * 0.5, cy - r * 0.5, cx + r * 0.5, cy + r * 0.5], width=4)

    def on_touch_down(self, t):
        if self.collide_point(*t.pos):
            app = App.get_running_app()
            app.is_muted = not getattr(app, 'is_muted', False)
            self.redraw()
            return True


class LoadingScreen(Screen):
    def on_enter(self):
        _schedule_canvas_refresh()
        self.lbl = Label(text="Generating.", font_size='17sp', bold=True)
        self.add_widget(self.lbl)
        self.dot_count = 1
        self.ticker = Clock.schedule_interval(self.update_dots, 0.5)
        threading.Thread(target=self.generate_maze, daemon=True).start()

    def update_dots(self, dt):
        self.dot_count = (self.dot_count % 3) + 1
        self.lbl.text = f"Generating{'.' * self.dot_count}"

    def generate_maze(self):
        app = App.get_running_app()
        mode = CURRENT_MODE
        map_file = get_map_file()

        if mode == MODE_20:
            loaded = None
            if os.path.exists(map_file):
                try:
                    with open(map_file, 'rb') as f:
                        d = pickle.load(f)
                        if d.get('version') == MAP_VERSION:
                            loaded = d
                except Exception:
                    loaded = None
            if loaded is not None:
                app.pre_gen_data = loaded
                app.current_level = loaded.get('level', 1)
            else:
                gen = MazeGenerator20(MAZE_W, MAZE_H, NUM_DEAD_ENDS)
                app.pre_gen_data = {
                    'version': MAP_VERSION, 'grid': gen.grid, 'buttons': gen.buttons,
                    'p_spawn': gen.p_spawn, 'e_spawns': gen.e_spawns,
                    'target_de': gen.target_de, 'dead_ends': gen.dead_ends,
                    'dead_end_positions': gen.dead_end_positions,
                    'level': app.current_level,
                }
                try:
                    with open(map_file, 'wb') as f:
                        pickle.dump(app.pre_gen_data, f)
                except Exception:
                    pass
        else:
            level = getattr(app, 'current_level', 1)
            app.pre_gen_data = None
            if os.path.exists(map_file):
                try:
                    with open(map_file, 'rb') as f:
                        d = pickle.load(f)
                        if d.get('version') == MAP_VERSION and d.get('level') == level:
                            app.pre_gen_data = d
                except Exception:
                    app.pre_gen_data = None
            if not app.pre_gen_data:
                if mode == MODE_50:
                    gen = MazeGeneratorLarge(50, 50, 625, 690, num_enemies=50)
                else:
                    gen = MazeGeneratorLarge(100, 100, 2500, 2750, num_enemies=100)
                app.pre_gen_data = {
                    'version': MAP_VERSION, 'level': level, 'grid': gen.grid,
                    'buttons': gen.buttons, 'p_spawn': gen.p_spawn,
                    'e_spawns': gen.e_spawns, 'target_de': gen.target_de,
                    'dead_ends': gen.dead_ends,
                    'dead_end_positions': gen.dead_end_positions,
                }
                try:
                    with open(map_file, 'wb') as f:
                        pickle.dump(app.pre_gen_data, f)
                except Exception:
                    pass

        app.is_restarting = False
        Clock.schedule_once(lambda dt: setattr(self.manager, 'current', 'game'), 0)

    def on_leave(self):
        self.ticker.cancel()
        self.clear_widgets()


class GameScreen(Screen):
    def on_enter(self):
        _schedule_canvas_refresh()
        self.f = FloatLayout()
        self.game = GameWorld20() if CURRENT_MODE == MODE_20 else GameWorldLarge()
        self.f.add_widget(self.game)

        self.joystick = MazeJoystick(self.game, size_hint=(None, None))
        self.game.joystick_ref = self.joystick
        self.f.add_widget(self.joystick)

        self.mute_btn = MuteButton(size_hint=(None, None))
        self.f.add_widget(self.mute_btn)

        self.add_widget(self.f)
        self.bind(size=self._relayout, pos=self._relayout)
        self._relayout()
        _schedule_canvas_refresh()

    def _relayout(self, *args):
        sw, sh = self.width, self.height
        if sw <= 0 or sh <= 0:
            return

        f_size = max(14, int(sw / 40))
        row_h = int(f_size * 1.8)
        hud_h = row_h * 4

        maze_size = sw
        maze_top = sh - hud_h
        maze_bottom = maze_top - maze_size

        if maze_bottom < MIN_JOY_SIZE:
            maze_size = max(MIN_JOY_SIZE, sh - hud_h - MIN_JOY_SIZE)
            maze_size = min(maze_size, sw)
            maze_bottom = sh - hud_h - maze_size

        avail_h = max(0, maze_bottom)

        joy_size = min(sw, avail_h)
        if joy_size < MIN_JOY_SIZE:
            joy_size = min(MIN_JOY_SIZE, max(avail_h, MIN_JOY_SIZE))
        joy_x = (sw - joy_size) / 2.0
        joy_y = max(0.0, (avail_h - joy_size) / 2.0)

        self.joystick.size = (joy_size, joy_size)
        self.joystick.pos = (joy_x, joy_y)

        ms = max(40, min(80, int(sw / 12)))
        self.mute_btn.size = (ms, ms)
        self.mute_btn.pos = (sw - ms - 10, sh - ms - 10)

        self.game.trigger_static_redraw()

    def on_leave(self):
        self.unbind(size=self._relayout, pos=self._relayout)
        self.game.destroy()
        self.clear_widgets()

    def show_overlay(self, state):
        if hasattr(self, 'joystick') and self.joystick in self.f.children:
            self.f.remove_widget(self.joystick)
        overlay = FloatLayout()
        if state == 'win':
            lbl = Label(text="Victory", font_size='50sp', color=(0, 1, 0, 0.7),
                        bold=True, pos_hint={'center_y': 0.6})
            btn = Button(text=f'Level {App.get_running_app().current_level + 1}',
                         size_hint=(0.8, 0.1), pos_hint={'center_x': 0.5, 'y': 0.05})
            btn.bind(on_release=lambda x: self.next_lvl())
            overlay.add_widget(lbl)
            overlay.add_widget(btn)
        else:
            lbl = Label(text="Defeat", font_size='23sp', color=(1, 0, 0, 0.7),
                        bold=True, pos_hint={'center_y': 0.6})
            btn_last = Button(text='Last', font_size='22sp',
                              size_hint=(1.0, 0.15),
                              pos_hint={'center_x': 0.5, 'y': 0.12})
            btn_last.bind(on_release=lambda x: self.restart_from('last'))
            overlay.add_widget(lbl)
            overlay.add_widget(btn_last)
            if has_any_save():
                btn_prev = Button(text='Prev', font_size='13sp',
                                  size_hint=(0.4, 0.06),
                                  pos_hint={'center_x': 0.5, 'y': 0.02})
                btn_prev.bind(on_release=lambda x: self.restart_from('pre_last'))
                overlay.add_widget(btn_prev)
        self.f.add_widget(overlay)
        _schedule_canvas_refresh()

    def next_lvl(self):
        app = App.get_running_app()
        app.is_restarting = False
        app.current_level += 1
        app.load_slot = 'last'
        delete_all_saves()
        try:
            map_file = get_map_file()
            if os.path.exists(map_file):
                os.remove(map_file)
        except OSError:
            pass
        self.manager.current = 'loading'

    def restart_from(self, slot):
        app = App.get_running_app()
        app.load_slot = slot
        app.is_restarting = True
        self.on_leave()
        self.on_enter()


class MenuScreen(Screen):
    def __init__(self, **kw):
        super().__init__(**kw)
        l = FloatLayout()
        l.add_widget(Label(text="Maze", font_size='50sp', pos_hint={'center_y': 0.85}))
        for y, text, mode in [(0.60, '100x100', MODE_100),
                              (0.44, '50x50', MODE_50),
                              (0.28, '20x20', MODE_20)]:
            btn = Button(text=text, font_size='30sp', bold=True,
                         size_hint=(.6, .12), pos_hint={'center_x': .5, 'center_y': y})
            btn.bind(on_release=lambda x, m=mode: self.start(m))
            l.add_widget(btn)
        self.add_widget(l)

    def on_enter(self):
        _schedule_canvas_refresh()

    def start(self, mode):
        set_current_mode(mode)
        app = App.get_running_app()
        app.current_level = 1
        app.is_restarting = False
        app.load_slot = 'last'
        self.manager.current = 'loading'


class DoorsApp(App):
    current_level = 1
    pre_gen_data = None
    is_restarting = False
    is_muted = False
    load_slot = 'last'

    def build(self):
        global SAVE_DIR
        try:
            SAVE_DIR = self.user_data_dir
            os.makedirs(SAVE_DIR, exist_ok=True)
        except Exception:
            SAVE_DIR = os.path.dirname(os.path.abspath(__file__))
            try:
                os.makedirs(SAVE_DIR, exist_ok=True)
            except OSError:
                pass

        sm = ScreenManager()
        for s, n in [(MenuScreen, 'menu'), (LoadingScreen, 'loading'), (GameScreen, 'game')]:
            sm.add_widget(s(name=n))
        return sm

    def on_start(self):
        _schedule_canvas_refresh()
        Clock.schedule_once(_force_canvas_refresh, 1.5)
        Clock.schedule_once(_force_canvas_refresh, 3.0)


if __name__ == '__main__':
    DoorsApp().run()
