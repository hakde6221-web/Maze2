TEXT_CACHE = {}


def get_text_texture(text, font_size):
    key = (str(text), int(font_size))
    if key not in TEXT_CACHE:
        l = CoreLabel(text=str(text), font_size=int(font_size), color=(1, 1, 1, 1), bold=True)
        l.refresh()
        TEXT_CACHE[key] = l.texture
    return TEXT_CACHE[key]


class SoundGenerator:
    @staticmethod
    def create_beep(freqs, durations, name):
        sample_rate = 44100
        buf = io.BytesIO()
        try:
            with wave.open(buf, 'wb') as wav_file:
                wav_file.setnchannels(1)
                wav_file.setsampwidth(2)
                wav_file.setframerate(sample_rate)
                for freq, dur in zip(freqs, durations):
                    num_samples = int(sample_rate * dur)
                    for i in range(num_samples):
                        volume = 32767 * (1 - i / num_samples)
                        value = int(volume * math.sin(2 * math.pi * freq * i / sample_rate))
                        wav_file.writeframes(struct.pack('<h', value))
            fname = os.path.join(tempfile.gettempdir(), f"sys_{name}.wav")
            with open(fname, 'wb') as f:
                f.write(buf.getvalue())
            return fname
        except Exception:
            return None

    @staticmethod
    def create_noise(duration, name):
        sample_rate = 44100
        buf = io.BytesIO()
        try:
            with wave.open(buf, 'wb') as wav_file:
                wav_file.setnchannels(1)
                wav_file.setsampwidth(2)
                wav_file.setframerate(sample_rate)
                num_samples = int(sample_rate * duration)
                for i in range(num_samples):
                    volume = 15000 * (1 - i / num_samples)
                    wav_file.writeframes(struct.pack('<h', int(volume * random.uniform(-1, 1))))
            fname = os.path.join(tempfile.gettempdir(), f"sys_{name}.wav")
            with open(fname, 'wb') as f:
                f.write(buf.getvalue())
            return fname
        except Exception:
            return None


