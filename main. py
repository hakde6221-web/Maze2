    def _apply_star_rotation(self, en, dx, dy):
        tris = en.get('g_star_triangles')
        if not tris:
            return
        local = en.get('g_star_local')
        if not local:
            return
        for tri, pts in zip(tris, local):
            rotated = []
            for px, py in pts:
                if dx == 0 and dy == 1:
                    rx, ry = px, py
                elif dx == 1 and dy == 0:
                    rx, ry = py, -px
                elif dx == 0 and dy == -1:
                    rx, ry = -px, -py
                elif dx == -1 and dy == 0:
                    rx, ry = -py, px
                else:
                    rx, ry = px, py
                rotated.extend((rx, ry))
            tri.points = rotated

    def _apply_enemy_rotation(self, en, dx, dy):
        if   dx == 0 and dy == 1:   fa = 0
        elif dx == 1 and dy == 0:   fa = 90
        elif dx == 0 and dy == -1:  fa = 180
        elif dx == -1 and dy == 0:  fa = 270
        else:                       fa = 0
        if en['turn_rule'] == 'right':
            a_s, a_e = fa - 17.5, fa + 50.0
        else:
            a_s, a_e = fa - 50.0, fa + 17.5
        en['g_mark'].circle = (0, 0, 18, a_s, a_e)
        pts, dots = en['g_pattern'], en['g_dots']
        for i in range(len(pts)):
            px, py = pts[i]
            if   dx == 0 and dy == 1:  rx, ry = px, py
            elif dx == 1 and dy == 0:  rx, ry = py, -px
            elif dx == 0 and dy == -1: rx, ry = -px, -py
            elif dx == -1 and dy == 0: rx, ry = -py, px
            else:                      rx, ry = px, py
            dots[i].pos = (rx - DOT_RAD, ry - DOT_RAD)
        self._apply_star_rotation(en, dx, dy)

    def _update_sleep_visual(self, en):
        sleeping = en.get('sleep_counter', 0) > 0
        alpha = SLEEP_ALPHA if sleeping else 1.0
        en['body_color_inst'].a = alpha
        en['mark_color_inst'].a = alpha
        for dc in en.get('g_dot_colors', ()):
            dc.a = alpha

    def _update_carrier_star_visual(self, en):
        group = en.get('g_star_group')
        if group is None:
            return
        if not en.get('is_carrier', False):
            group.clear()
            en['g_star_triangles'] = []
            en['g_star_local'] = []
            en['g_star_color'] = None
            return
        cid = en.get('color_id', 0)
        mc = self.color_palette[cid] if (self.color_palette and 0 <= cid < len(self.color_palette)) else (1, 0, 0)
        cycle_set = getattr(self, 'sleep_cycle_set', None)
        alpha = 0.4 if (cycle_set is not None and en['idx'] in cycle_set) else 1.0
        if not en.get('g_star_triangles'):
            group.clear()
            outer_r = (CELL_SIZE - 4) / 2.0
            inner_r = outer_r * 0.382
            verts = []
            for i in range(10):
                angle = math.pi / 2 + i * math.pi / 5
                r = outer_r if i % 2 == 0 else inner_r
                verts.append((r * math.cos(angle), r * math.sin(angle)))
            color_inst = Color(mc[0], mc[1], mc[2], alpha)
            group.add(color_inst)
            tris = []
            local = []
            for i in range(10):
                x1, y1 = verts[i]
                x2, y2 = verts[(i + 1) % 10]
                tri = Triangle(points=[0, 0, x1, y1, x2, y2])
                group.add(tri)
                tris.append(tri)
                local.append([(0, 0), (x1, y1), (x2, y2)])
            en['g_star_color'] = color_inst
            en['g_star_triangles'] = tris
            en['g_star_local'] = local
            dx, dy = en['dir'].x, en['dir'].y
            if dx == 0 and dy == 0:
                dx, dy = en['last_dir'].x, en['last_dir'].y
            self._apply_star_rotation(en, dx, dy)
        else:
            color_inst = en.get('g_star_color')
            if color_inst is not None:
                color_inst.rgba = (mc[0], mc[1], mc[2], alpha)

    def _update_carrier_visual(self, en):
        en['body_color_inst'].rgba = (WALL_COLOR[0], WALL_COLOR[1], WALL_COLOR[2], 1)
        cid = en.get('color_id', 0)
