    def _draw_labeled_colored(self, label, total, counts, palette, x, y, fs):
        w = self._draw_text(label, x, y, fs); x += w + 6
        w = self._draw_text(str(total), x, y, fs); x += w + 4
        w = self._draw_text("(", x, y, fs); x += w + 2
        for i, cnt in enumerate(counts):
            if i > 0:
                w = self._draw_text(",", x, y, fs); x += w + 3
            rgb = palette[i] if i < len(palette) else (1, 1, 1)
            w = self._draw_text_colored(str(cnt), x, y, fs, rgb); x += w + 3
        w = self._draw_text(")", x, y, fs); x += w
        return x

    def enemy_tick(self):
        app = App.get_running_app()

        was_sleeping = set()
        for en in self.enemies:
            sc = en.get('sleep_counter', 0)
            if sc > 0:
                was_sleeping.add(id(en))
                en['sleep_counter'] = sc - 1
                en['dir'] = VEC_ZERO
                en['next_cell'] = en['current_cell']
        any_sleeping = len(was_sleeping) > 0

        for en in self.enemies:
            if id(en) in was_sleeping:
                en['_just_moved'] = False
                continue
            old = en['current_cell']
            en['current_cell'] = en['next_cell']
            en['grid'] = Vector(*en['current_cell'])
            en['_just_moved'] = (old != en['current_cell'])

        enemy_positions = {en['current_cell'] for en in self.enemies}

        newly_sleeping = set()
        if not any_sleeping and self.sleep_cycle_set:
            candidates = []
            for en in self.enemies:
                if id(en) in was_sleeping:
                    continue
                if en['current_cell'] not in self.dead_ends_set:
                    continue
                if en['idx'] not in self.sleep_cycle_set:
                    continue
                candidates.append(en)
            if candidates:
                candidates.sort(key=lambda e: e['idx'])
                chosen = candidates[0]
                chosen['sleep_counter'] = 3
                chosen['dir'] = VEC_ZERO
                chosen['next_cell'] = chosen['current_cell']
                chosen['_just_moved'] = True
                self.sleep_cycle_set.discard(chosen['idx'])
                if not self.sleep_cycle_set:
                    self.sleep_cycle_set = set(e['idx'] for e in self.enemies)
                was_sleeping.add(id(chosen))
                newly_sleeping.add(id(chosen))

        active_enemies = [en for en in self.enemies if id(en) not in was_sleeping]
        intents = self._resolve_enemy_intents(active_enemies)

        union_vis = set()
        for en in self.enemies:
            if id(en) not in was_sleeping:
                tgt = intents.get(en['idx'])
                if tgt is None or tgt == en['current_cell']:
                    en['dir'] = VEC_ZERO
                    en['next_cell'] = en['current_cell']
                else:
                    new_dir = Vector(tgt[0] - en['current_cell'][0],
                                     tgt[1] - en['current_cell'][1])
                    en['dir'] = new_dir
                    en['last_dir'] = new_dir
                    en['next_cell'] = tgt
            en['visible_cells'] = self.get_enemy_los(en, enemy_positions)
            union_vis |= en['visible_cells']

        self.union_visible_cells = union_vis

        self.last_p_cells = self.get_occupied_cells(self.p_pixel)
        if len(self.last_p_cells) == 1:
            cell = next(iter(self.last_p_cells))
            if cell in union_vis:
                self.active = False
                if self.snd_lose and not app.is_muted: self.snd_lose.play()
                app.root.get_screen('game').show_overlay('lose')
                return

        self.enemy_tick_counter += 1

    def update(self, dt):
        if not self.active: return
        app = App.get_running_app()
        self.time_accumulator = min(self.time_accumulator + dt, 0.25)
        sub_steps, state_dirty = 0, False
        gx, gy = int(self.player_grid.x), int(self.player_grid.y)

        while self.time_accumulator >= self.dt_step and sub_steps < 3:
            self.time_accumulator -= self.dt_step
            self.logic_steps += 1
            sub_steps += 1
            if not self.active: break
            just_colored = False
            self.last_p_cells = self.get_occupied_cells(self.p_pixel)

            if len(self.last_p_cells) == 1:
                cell = next(iter(self.last_p_cells))
                if cell in self.union_visible_cells:
                    self.active = False
                    if self.snd_lose and not app.is_muted: self.snd_lose.play()
                    app.root.get_screen('game').show_overlay('lose')
                    return

            _e_prog = max(0.0, min(1.0, self.enemy_time / self.enemy_step_interval)) if self.enemy_step_interval > 0 else 1.0
            TOUCH_SQ = (CELL_SIZE * 0.85) ** 2
            for en in self.enemies:
                ccx, ccy = en['current_cell']
                ncx, ncy = en['next_cell']
                ex = ccx * TOTAL_STEP + (ncx - ccx) * TOTAL_STEP * _e_prog
                ey = ccy * TOTAL_STEP + (ncy - ccy) * TOTAL_STEP * _e_prog
                dx, dy = self.p_pixel.x - ex, self.p_pixel.y - ey
                if dx * dx + dy * dy < TOUCH_SQ:
                    self.active = False
                    if self.snd_lose and not app.is_muted: self.snd_lose.play()
                    app.root.get_screen('game').show_overlay('lose')
                    return

            target = self.player_grid * TOTAL_STEP
            was_moving = self.p_dir != VEC_ZERO
            dxt = self.p_pixel.x - target.x
            dyt = self.p_pixel.y - target.y
            recalc_dists = False

            if dxt * dxt + dyt * dyt <= self.p_speed ** 2:
                self.p_pixel = Vector(target)
                gx, gy = int(self.player_grid.x), int(self.player_grid.y)
                if self.player_last_cell != (gx, gy):
                    self.player_last_cell = (gx, gy)
                    recalc_dists = True
                    redraw_int = False

                    if (gx, gy) in self.buttons and (gx, gy) not in self.touched_buttons \
                            and self.buttons[(gx, gy)]['collectible']:
                        self.touched_buttons.add((gx, gy))
                        just_colored = True
                        state_dirty = True
                        redraw_int = True
                        self._check_hatch_open(app)
                        will_autosave = (len(self.touched_buttons) % self.autosave_every == 0)
                        if will_autosave:
                            self.save_game_state()
                            if self.snd_checkpoint and not app.is_muted:
                                self.snd_checkpoint.play()
                            self._flash_checkpoint()
                        else:
                            if self.snd_color and not app.is_muted:
                                self.snd_color.play()

                    if redraw_int:
                        if self.IS_LARGE:
                            if self.last_drawn_chunk is not None:
                                self.draw_interactive(*self.last_drawn_chunk)
                        else:
                            self.interactive_redraw_needed = True

                    if self.hatch_open and (gx, gy) == self.hatch_pos:
                        self.active = False
                        if self.snd_joy and not app.is_muted: self.snd_joy.play()
                        delete_all_saves()
                        app.root.get_screen('game').show_overlay('win')
                        return

                avail = self.get_avail(gx, gy)
                has_door = self._has_adjacent_door(gx, gy)
                if self.p_dir != VEC_ZERO:
                    if self.next_dir is not None and self.next_dir != self.p_dir:
                        self.p_dir, self.next_dir = VEC_ZERO, None
                    elif has_door:
                        self.p_dir = VEC_ZERO
                    else:
                        fps = [d for d in avail if d != -self.p_dir]
                        self.p_dir = VEC_ZERO if len(avail) > 2 else (
                            fps[0] if len(avail) == 2 and len(fps) == 1 else VEC_ZERO)
                if self.p_dir == VEC_ZERO and self.next_dir in avail:
                    self.p_dir = self.next_dir
                self.next_dir = None

                if self.p_dir != VEC_ZERO:
                    ngx = gx + int(self.p_dir.x)
                    ngy = gy + int(self.p_dir.y)
                    target_cell = (ngx, ngy)
                    if self.enemy_step_interval > 0:
                        prog = max(0.0, min(1.0, self.enemy_time / self.enemy_step_interval))
                    else:
                        prog = 1.0
                    blocked = False
                    for en in self.enemies:
                        cc = en['current_cell']
                        nc = en['next_cell']
                        if cc == target_cell:
                            if nc == target_cell:
                                blocked = True
                                break
                            if prog < 0.3:
                                blocked = True
                                break
                        elif nc == target_cell:
                            blocked = True
                            break
                    if blocked:
                        self.p_dir = VEC_ZERO
                        self.next_dir = None

                if was_moving and self.p_dir == VEC_ZERO and not just_colored \
                        and self.snd_stop and not app.is_muted:
                    self.snd_stop.play()
                if self.p_dir != VEC_ZERO:
                    self.last_p_dir = Vector(self.p_dir)
                    self.player_grid += self.p_dir
            else:
                self.p_pixel += (target - self.p_pixel).normalize() * self.p_speed

            if recalc_dists:
                self._refresh_player_dists()
                state_dirty = True

        if sub_steps >= 3:
            self.time_accumulator = 0.0
        if not self.active: return

        self.enemy_time += min(dt, 0.5)
        ticked = False
        while self.enemy_time >= self.enemy_step_interval:
            self.enemy_time -= self.enemy_step_interval
            self.enemy_tick()
            ticked = True
            if not self.active:
                gx2 = int(self.player_grid.x)
                gy2 = int(self.player_grid.y)
                if self.IS_LARGE:
                    self.draw_entities(gx2, gy2)
                else:
                    self.draw_entities()
                return

        gx, gy = int(self.player_grid.x), int(self.player_grid.y)

        if self.IS_LARGE:
            if self.last_drawn_chunk != (gx, gy):
                self.last_drawn_chunk = (gx, gy)
                self.draw_static(gx, gy)
                self.draw_interactive(gx, gy)
                self.draw_doors(gx, gy)
            if self.interactive_redraw_needed:
                self.interactive_redraw_needed = False
                self.draw_interactive(gx, gy)
            self.update_camera()
            self.draw_entities(gx, gy)
        else:
            if self.interactive_redraw_needed:
                self.interactive_redraw_needed = False
                self.draw_interactive()
            self.update_camera()
            self.draw_entities()

        if ticked or state_dirty:
            self._update_hud_state()

    def _draw_player_eyes(self):
        self.p_body_inst.pos = (self.p_pixel.x, self.p_pixel.y)
        pcx = self.p_pixel.x + CELL_SIZE / 2
        pcy = self.p_pixel.y + CELL_SIZE / 2
        dx, dy = self.last_p_dir.x, self.last_p_dir.y
        ef, es, er = 10, 6, 3
        lx, ly = pcx + dx * ef - dy * es, pcy + dy * ef + dx * es
        rx, ry = pcx + dx * ef + dy * es, pcy + dy * ef - dx * es
        self.p_left_eye_inst.pos = (lx - er, ly - er)
        self.p_left_eye_inst.size = (er * 2, er * 2)
        self.p_right_eye_inst.pos = (rx - er, ry - er)
        self.p_right_eye_inst.size = (er * 2, er * 2)


