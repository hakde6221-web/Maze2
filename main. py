class MazeJoystick(Widget):
    def __init__(self, game, **kwargs):
        super().__init__(**kwargs)
        self.game = game
        self.active_sector = None
        self.snd_click = SoundLoader.load(SND_JOY_PATH)
        self.sectors = [{'v': (0, 1), 's': 315, 'e': 405}, {'v': (1, 0), 's': 45, 'e': 135},
                        {'v': (0, -1), 's': 135, 'e': 225}, {'v': (-1, 0), 's': 225, 'e': 315}]
        self.bind(pos=self.redraw, size=self.redraw)

    def collide_point(self, x, y):
        cx = self.x + self.width / 2.0
        cy = self.y + self.height / 2.0
        r = min(self.width, self.height) / 2.0
        dx, dy = x - cx, y - cy
        return dx * dx + dy * dy <= r * r

    def redraw(self, *args):
        self.canvas.clear()
        cx, cy = self.x + self.width / 2.0, self.y + self.height / 2.0
        max_r = min(self.width, self.height) / 2.0
        if max_r <= 0: return
        ot = max(4, max_r * 0.05)
        r = max_r - ot / 2.0
        with self.canvas:
            Color(*WALL_COLOR)
            Ellipse(pos=(cx - r - ot / 2, cy - r - ot / 2), size=(r * 2 + ot, r * 2 + ot))
            Color(0.15, 0.15, 0.15)
            Ellipse(pos=(cx - r, cy - r), size=(r * 2, r * 2))
            for i, s in enumerate(self.sectors):
                Color(*(0, 1, 1, 1) if i == self.active_sector else (0.25, 0.25, 0.25, 1))
                Ellipse(pos=(cx - r * 0.95, cy - r * 0.95), size=(r * 1.9, r * 1.9),
                        angle_start=s['s'], angle_end=s['e'])
            Color(*WALL_COLOR)
            for angle in (45, 135):
                rad = math.radians(angle)
                dx, dy = math.cos(rad) * r * 0.95, math.sin(rad) * r * 0.95
                Line(points=[cx - dx, cy - dy, cx + dx, cy + dy], width=max(2, ot / 2))
            Color(0.1, 0.1, 0.1)
            Ellipse(pos=(cx - r * 0.2, cy - r * 0.2), size=(r * 0.4, r * 0.4))

    def on_touch_down(self, t):
        if self.collide_point(*t.pos):
            self.handle(t); return True

    def on_touch_move(self, t):
        if self.collide_point(*t.pos):
            self.handle(t); return True

    def on_touch_up(self, t):
        if self.active_sector is not None:
            self.active_sector = None
            self.game.current_joy_dir = None
            self.redraw()

    def handle(self, t):
        app = App.get_running_app()
        if getattr(app, 'is_paused', False):
            app.is_paused = False
            try:
                screen = app.root.current_screen
                if hasattr(screen, 'pause_btn'):
                    screen.pause_btn.redraw()
            except Exception:
                pass
        cx, cy = self.x + self.width / 2.0, self.y + self.height / 2.0
        r = min(self.width, self.height) / 2.0
        dx, dy = t.x - cx, t.y - cy
        if dx * dx + dy * dy < (r * 0.15) ** 2:
            return
        a = math.degrees(math.atan2(dx, dy)) % 360
        idx = 0 if (315 <= a or a < 45) else 1 if 45 <= a < 135 else 2 if 135 <= a < 225 else 3
        self.game.current_joy_dir = Vector(self.sectors[idx]['v'])
        if self.active_sector != idx:
            self.active_sector = idx
            if self.snd_click and not app.is_muted:
                self.snd_click.play()
            self.game.next_dir = Vector(self.sectors[idx]['v'])
            self.redraw()


