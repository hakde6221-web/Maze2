class LoadingScreen(Screen):
    def on_enter(self):
        _schedule_canvas_refresh()
        self.lbl = Label(text="Generating.", font_size='17sp', bold=True,
                         color=(*TEXT_COLOR, 1))
        self.add_widget(self.lbl)
        self.dot_count = 1
        self.ticker = Clock.schedule_interval(self.update_dots, 0.5)
        threading.Thread(target=self.generate_maze, daemon=True).start()

    def update_dots(self, dt):
        self.dot_count = (self.dot_count % 3) + 1
        self.lbl.text = f"Generating{'.' * self.dot_count}"

    def _generate_grid(self, mode):
        if mode == MODE_10:
            gen = MazeGenerator10()
        elif mode == MODE_20:
            gen = MazeGenerator20(MAZE_W, MAZE_H, NUM_DEAD_ENDS)
        elif mode == MODE_50:
            gen = MazeGeneratorLarge(50, 50)
        else:
            gen = MazeGeneratorLarge(100, 100)
        return {
            'version': MAP_VERSION,
            'grid': gen.grid,
            'p_spawn': gen.p_spawn,
            'target_de': gen.target_de,
            'dead_ends': gen.dead_ends,
            'level': App.get_running_app().current_level,
        }

    def _write_map_atomic(self, map_file, pre_data):
        tmp_path = map_file + '.tmp'
        try:
            with open(tmp_path, 'wb') as f:
                pickle.dump(pre_data, f)
            os.replace(tmp_path, map_file)
            return True
        except Exception:
            try:
                if os.path.exists(tmp_path):
                    os.remove(tmp_path)
            except OSError:
                pass
            return False

    def generate_maze(self):
        app = App.get_running_app()
        mode = CURRENT_MODE
        map_file = get_map_file()
        pending = getattr(app, 'pending_new_level', False)
        app.pending_new_level = False

        max_attempts = 12
        success = False

        for attempt in range(max_attempts):
            pre_data = None

            if attempt == 0 and not pending and os.path.exists(map_file):
                try:
                    with open(map_file, 'rb') as f:
                        d = pickle.load(f)
                    if d.get('version') == MAP_VERSION and 'door_colors' in d:
                        pre_data = d
                except Exception:
                    pre_data = None

            if pre_data is None:
                pre_data = self._generate_grid(mode)

            grid = pre_data.get('grid')
            if not grid:
                continue
            w = len(grid[0])
            h = len(grid)
            dead_ends_set = set(pre_data.get('dead_ends', []))

            doors, door_colors, pocket_cells = _compute_doors_with_corridor_check(
                grid, w, h, dead_ends_set, num_colors=5)
            if doors is not None:
                pre_data['door_edges'] = doors
                pre_data['door_colors'] = door_colors
                pre_data['pocket_cells'] = list(pocket_cells)
                app.pre_gen_data = pre_data
                app.current_level = pre_data.get('level', 1)

                map_ok = self._write_map_atomic(map_file, pre_data)

                if pending and map_ok:
                    delete_all_saves()

                success = True
                break
            else:
                if not pending:
                    try:
                        if os.path.exists(map_file):
                            os.remove(map_file)
                    except OSError:
                        pass

        if not success:
            pre_data = self._generate_grid(mode)
            grid = pre_data['grid']
            dead_ends_set = set(pre_data['dead_ends'])
            doors, door_colors, pocket_cells = _place_doors_no_corridor_check(
                grid, dead_ends_set, num_colors=5)
            pre_data['door_edges'] = doors
            pre_data['door_colors'] = door_colors
            pre_data['pocket_cells'] = list(pocket_cells)
            app.pre_gen_data = pre_data
            app.current_level = pre_data.get('level', 1)

            map_ok = self._write_map_atomic(map_file, pre_data)

            if pending and map_ok:
                delete_all_saves()

        app.is_restarting = False
        Clock.schedule_once(lambda dt: setattr(self.manager, 'current', 'game'), 0)

    def on_leave(self):
        self.ticker.cancel()
        self.clear_widgets()


class GameScreen(Screen):
    def on_enter(self):
        _schedule_canvas_refresh()
        App.get_running_app().is_paused = False
        self.f = FloatLayout()
        if CURRENT_MODE == MODE_10:
            self.game = GameWorld10()
        elif CURRENT_MODE == MODE_20:
            self.game = GameWorld20()
        else:
            self.game = GameWorldLarge()
        self.f.add_widget(self.game)

        self.joystick = MazeJoystick(self.game, size_hint=(None, None))
        self.game.joystick_ref = self.joystick
        self.f.add_widget(self.joystick)

        self.mute_btn = MuteButton(size_hint=(None, None))
        self.f.add_widget(self.mute_btn)

        self.pause_btn = PauseButton(size_hint=(None, None))
        self.f.add_widget(self.pause_btn)

        self.add_widget(self.f)
        self.bind(size=self._relayout, pos=self._relayout)
        self._relayout()
        _schedule_canvas_refresh()

    def _relayout(self, *args):
        sw, sh = self.width, self.height
        if sw <= 0 or sh <= 0:
            return
        game = getattr(self, 'game', None)
        is_landscape = (sw > sh)

        if not is_landscape:
            f_size, row_h, trophy_h, autosave_h, hud_h = _compute_hud_dims(sw, False)

            maze_size = min(sw, sh - hud_h)
            maze_top = sh - hud_h
            maze_bottom = maze_top - maze_size
            if maze_bottom < MIN_JOY_SIZE:
                maze_size = max(MIN_JOY_SIZE, sh - hud_h - MIN_JOY_SIZE)
                maze_size = min(maze_size, sw)
                maze_bottom = sh - hud_h - maze_size

            avail_h = max(0, maze_bottom)
            joy_size = min(sw, avail_h)
            if joy_size < MIN_JOY_SIZE:
                joy_size = min(MIN_JOY_SIZE, max(avail_h, MIN_JOY_SIZE))
            joy_x = (sw - joy_size) / 2.0
            joy_y = max(0.0, (avail_h - joy_size) / 2.0)
            self.joystick.size = (joy_size, joy_size)
            self.joystick.pos = (joy_x, joy_y)

            ms = max(60, min(120, int(sw / 8)))
            self.mute_btn.size = (ms, ms)
            self.mute_btn.pos = (sw - ms - 10, sh - ms - 10)
            self.pause_btn.size = (ms, ms)
            self.pause_btn.pos = (sw - 2 * ms - 20, sh - ms - 10)
        else:
            f_size, row_h, trophy_h, autosave_h, hud_h = _compute_hud_dims(sh, False)
            left_w = max(160, int(sh * 0.38))
            right_w = max(MIN_JOY_SIZE, int(sh * 0.4))

            joy_size = min(right_w - 20, sh - 20)
            joy_size = max(MIN_JOY_SIZE, joy_size)
            joy_x = sw - right_w + (right_w - joy_size) / 2.0
            joy_y = (sh - joy_size) / 2.0
            self.joystick.size = (joy_size, joy_size)
            self.joystick.pos = (joy_x, joy_y)

            ms = max(50, min(90, int(sh / 8)))
            self.mute_btn.size = (ms, ms)
            self.mute_btn.pos = (left_w - ms - 10, sh - ms - 10)
            self.pause_btn.size = (ms, ms)
            self.pause_btn.pos = (left_w - 2 * ms - 20, sh - ms - 10)

        if game is not None:
            game.trigger_static_redraw()

    def on_leave(self):
        self.unbind(size=self._relayout, pos=self._relayout)
        self.game.destroy()
        self.clear_widgets()

    def show_overlay(self, state):
        if hasattr(self, 'game') and hasattr(self.game, '_show_pause_label'):
            self.game._show_pause_label(False)
        if hasattr(self, 'joystick') and self.joystick in self.f.children:
            self.f.remove_widget(self.joystick)
        overlay = FloatLayout()
        if state == 'win':
            lbl = Label(text="Victory", font_size='50sp', color=(0, 1, 0, 0.5),
                        bold=True, pos_hint={'center_y': 0.6})
            overlay.add_widget(lbl)
            self.f.add_widget(overlay)

            def _show_win_btn(dt):
                btn = Button(text=f'Level {App.get_running_app().current_level + 1}',
                             size_hint=(0.8, 0.1), pos_hint={'center_x': 0.5, 'y': 0.05},
                             color=(*TEXT_COLOR, 1))
                btn.bind(on_release=lambda x: self.next_lvl())
                overlay.add_widget(btn)
                _schedule_canvas_refresh()

            Clock.schedule_once(_show_win_btn, 2.0)
        else:
            lbl = Label(text="You were noticed", font_size='23sp', color=(1, 0, 0, 0.5),
                        bold=True, pos_hint={'center_y': 0.6})
            overlay.add_widget(lbl)
            self.f.add_widget(overlay)

            def _show_lose_btns(dt):
                btn_last = Button(text='Last', font_size='22sp', size_hint=(0.45, 0.15),
                                  pos_hint={'center_x': 0.5, 'y': 0.12},
                                  color=(*TEXT_COLOR, 1))
                btn_last.bind(on_release=lambda x: self.restart_from('last'))
                overlay.add_widget(btn_last)
                if has_any_save():
                    btn_prev = Button(text='Prev', font_size='20sp', size_hint=(0.45, 0.09),
                                      pos_hint={'center_x': 0.25, 'y': 0.02},
                                      color=(*TEXT_COLOR, 1))
                    btn_prev.bind(on_release=lambda x: self.restart_from('pre_last'))
                    overlay.add_widget(btn_prev)
                    btn_menu = Button(text='Menu', font_size='20sp', size_hint=(0.45, 0.09),
                                      pos_hint={'center_x': 0.75, 'y': 0.02},
                                      color=(*TEXT_COLOR, 1))
                    btn_menu.bind(on_release=lambda x: self.go_menu())
                    overlay.add_widget(btn_menu)
                else:
                    btn_menu = Button(text='Menu', font_size='20sp', size_hint=(0.45, 0.09),
                                      pos_hint={'center_x': 0.5, 'y': 0.02},
                                      color=(*TEXT_COLOR, 1))
                    btn_menu.bind(on_release=lambda x: self.go_menu())
                    overlay.add_widget(btn_menu)
                _schedule_canvas_refresh()

            Clock.schedule_once(_show_lose_btns, 2.0)
        _schedule_canvas_refresh()

    def go_menu(self):
        app = App.get_running_app()
        app.is_restarting = False
        self.manager.current = 'menu'

    def next_lvl(self):
        app = App.get_running_app()
        app.is_restarting = False
        app.current_level += 1
        app.load_slot = 'last'
        app.pending_new_level = True
        self.manager.current = 'loading'

    def restart_from(self, slot):
        app = App.get_running_app()
        app.load_slot = slot
        app.is_restarting = True
        self.on_leave()
        self.on_enter()


