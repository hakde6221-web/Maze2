def _draw_star(group, cx, cy, size, rgb):
    if size <= 0:
        return
    if not (isinstance(rgb, (list, tuple)) and len(rgb) >= 3):
        rgb = (1, 1, 1)
    outer_r = size / 2.0
    inner_r = outer_r * 0.382
    verts = []
    for i in range(10):
        angle = math.pi / 2 + i * math.pi / 5
        r = outer_r if i % 2 == 0 else inner_r
        verts.append((cx + r * math.cos(angle), cy + r * math.sin(angle)))
    group.add(Color(rgb[0], rgb[1], rgb[2], 1))
    for i in range(10):
        x1, y1 = verts[i]
        x2, y2 = verts[(i + 1) % 10]
        group.add(Triangle(points=[cx, cy, x1, y1, x2, y2]))


def _draw_star_outline(group, cx, cy, size, rgba, width=1.5):
    if size <= 0:
        return
    outer_r = size / 2.0
    inner_r = outer_r * 0.382
    pts = []
    for i in range(10):
        angle = math.pi / 2 + i * math.pi / 5
        r = outer_r if i % 2 == 0 else inner_r
        pts.extend([cx + r * math.cos(angle), cy + r * math.sin(angle)])
    alpha = rgba[3] if (isinstance(rgba, (list, tuple)) and len(rgba) > 3) else 1
    group.add(Color(rgba[0], rgba[1], rgba[2], alpha))
    group.add(Line(points=pts, close=True, width=width))


def _find_door_edge_for_de_pure(maze_data, de):
    cell = maze_data[de[1]][de[0]]
    first_move = None
    for d, (dx, dy) in DIRS.items():
        if cell[d] == 0:
            first_move = (de[0] + dx, de[1] + dy)
            break
    if first_move is None:
        return None, [de]
    path = [de, first_move]
    prev, cur = de, first_move
    visited = {de, first_move}
    while True:
        cell_data = maze_data[cur[1]][cur[0]]
        openings = sum(1 for d in DIRS if cell_data[d] == 0)
        if openings >= 3:
            return ((prev, cur) if prev < cur else (cur, prev)), path
        next_cell = None
        for d, (dx, dy) in DIRS.items():
            if cell_data[d] == 0:
                cand = (cur[0] + dx, cur[1] + dy)
                if cand != prev:
                    next_cell = cand
                    break
        if next_cell is None or next_cell in visited:
            return None, path
        visited.add(next_cell)
        prev, cur = cur, next_cell
        path.append(cur)


def _assign_door_colors_spatially_impl(all_doors, num_colors):
    if num_colors <= 0 or not all_doors:
        return {}
    doors = sorted(all_doors)
    n = len(doors)
    if n == 1:
        return {doors[0]: 0}

    base, rem = divmod(n, num_colors)
    counts = [base + (1 if c < rem else 0) for c in range(num_colors)]

    interleaved = []
    max_c = max(counts) if counts else 0
    for r in range(max_c):
        for c in range(num_colors):
            if r < counts[c]:
                interleaved.append(c)

    mids = [((a[0] + b[0]) * 0.5, (a[1] + b[1]) * 0.5) for (a, b) in doors]

    INF = float('inf')
    min_to_any = [INF] * n
    min_to_own = [[INF] * n for _ in range(num_colors)]

    result = {}
    picked_count = [0] * num_colors
    picked_total = 0
    remaining = set(range(n))

    for c in interleaved:
        if not remaining:
            break

        if picked_count[c] == 0 and picked_total == 0:
            best_i = min(remaining)
        else:
            best_i = -1
            best_d = -1.0
            if picked_count[c] == 0:
                for i in remaining:
                    if min_to_any[i] > best_d:
                        best_d = min_to_any[i]
                        best_i = i
            else:
                own_c = min_to_own[c]
                for i in remaining:
                    if own_c[i] > best_d:
                        best_d = own_c[i]
                        best_i = i

        xi, yi = mids[best_i]
        own_c = min_to_own[c]
        for j in remaining:
            xj, yj = mids[j]
            dx = xi - xj
            dy = yi - yj
            d = dx * dx + dy * dy
            if d < min_to_any[j]:
                min_to_any[j] = d
            if d < own_c[j]:
                own_c[j] = d

        result[doors[best_i]] = c
        picked_count[c] += 1
        picked_total += 1
        remaining.discard(best_i)

    return result


def _distribute_color_reduction(color_area, color_movable, need, num_colors):
    reductions = [0] * num_colors
    current = list(color_area)
    remaining = need

    while remaining > 0:
        best_c = -1
        best_val = -1
        for c in range(num_colors):
            if reductions[c] < color_movable[c] and current[c] > best_val:
                best_val = current[c]
                best_c = c
        if best_c < 0:
            break

        cap = color_movable[best_c] - reductions[best_c]
        other_max = 0
        for c in range(num_colors):
            if c != best_c and current[c] > other_max:
                other_max = current[c]

        if best_val > other_max:
            step = min(best_val - other_max, cap, remaining)
        else:
            step = min(1, cap, remaining)
        if step <= 0:
            break

        reductions[best_c] += step
        current[best_c] -= step
        remaining -= step

    return reductions, remaining


def _compute_doors_with_corridor_check(maze_data, w, h, dead_ends_set, num_colors=5):
    target = (w * h) // 2
    door_edges = {}
    paths = {}
    for de in dead_ends_set:
        edge, path = _find_door_edge_for_de_pure(maze_data, de)
        if edge is not None:
            door_edges[de] = edge
            paths[de] = path
    if not door_edges:
        return None, None, None

    region_sizes = {de: len(paths[de]) - 1 for de in door_edges}
    corridor = w * h - sum(region_sizes.values())

    if corridor > target:
        return None, None, None

    initial_doors = set(door_edges.values())
    color_map = _assign_door_colors_spatially_impl(initial_doors, num_colors)

    if corridor == target:
        pocket_cells = set()
        for de in door_edges:
            pocket_cells.update(paths[de][:-1])
        return door_edges, color_map, pocket_cells

    need = target - corridor
    max_move = {de: region_sizes[de] - 1 for de in door_edges}
    total_available = sum(max_move.values())
    if total_available < need:
        return None, None, None

    door_to_color = {}
    color_area = [0] * num_colors
    for de, edge in door_edges.items():
        cid = color_map.get(edge, 0)
        door_to_color[de] = cid
        color_area[cid] += region_sizes[de]

    color_movable = [0] * num_colors
    for de in door_edges:
        color_movable[door_to_color[de]] += max_move[de]

    reductions, leftover = _distribute_color_reduction(
        color_area, color_movable, need, num_colors)
    if leftover > 0:
        return None, None, None

    move_counts = {de: 0 for de in door_edges}
    for c in range(num_colors):
        red = reductions[c]
        if red <= 0:
            continue
        doors_c = [de for de in door_edges if door_to_color[de] == c]
        doors_c.sort(key=lambda de: -max_move[de])
        for de in doors_c:
            if red <= 0:
                break
            step = min(red, max_move[de] - move_counts[de])
            move_counts[de] += step
            red -= step

    new_door_edges = {}
    new_color_map = {}
    pocket_cells = set()
    for de in door_edges:
        k = len(paths[de]) - 1
        new_k = k - move_counts[de]
        a = paths[de][new_k - 1]
        b = paths[de][new_k]
        new_edge = (a, b) if a < b else (b, a)
        new_door_edges[de] = new_edge
        new_color_map[new_edge] = door_to_color[de]
        for cell in paths[de][:new_k]:
            pocket_cells.add(cell)

    return new_door_edges, new_color_map, pocket_cells


def _place_doors_no_corridor_check(maze_data, dead_ends_set, num_colors=5):
    doors = {}
    paths = {}
    for de in dead_ends_set:
        edge, path = _find_door_edge_for_de_pure(maze_data, de)
        if edge is not None:
            doors[de] = edge
            paths[de] = path
    door_set = set(doors.values())
    colors = _assign_door_colors_spatially_impl(door_set, num_colors)
    pocket_cells = set()
    for de, path in paths.items():
        pocket_cells.update(path[:-1])
    return doors, colors, pocket_cells


class SoundGenerator:
    @staticmethod
    def create_beep(freqs, durations, name):
        fname = os.path.join(os.path.dirname(os.path.abspath(__file__)), f"sys_{name}.wav")
        try:
            if os.path.exists(fname) and os.path.getsize(fname) > 0:
                return fname
        except OSError:
            pass
        sample_rate = 44100
        buf = io.BytesIO()
        try:
            with wave.open(buf, 'wb') as wav_file:
                wav_file.setnchannels(1)
                wav_file.setsampwidth(2)
                wav_file.setframerate(sample_rate)
                for freq, dur in zip(freqs, durations):
                    num_samples = int(sample_rate * dur)
                    for i in range(num_samples):
                        volume = 32767 * (1 - i / num_samples)
                        value = int(volume * math.sin(2 * math.pi * freq * i / sample_rate))
                        wav_file.writeframes(struct.pack('<h', value))
            with open(fname, 'wb') as f:
                f.write(buf.getvalue())
            return fname
        except Exception:
            return None

    @staticmethod
    def create_noise(duration, name):
        fname = os.path.join(os.path.dirname(os.path.abspath(__file__)), f"sys_{name}.wav")
        try:
            if os.path.exists(fname) and os.path.getsize(fname) > 0:
                return fname
        except OSError:
            pass
        sample_rate = 44100
        buf = io.BytesIO()
        try:
            with wave.open(buf, 'wb') as wav_file:
                wav_file.setnchannels(1)
                wav_file.setsampwidth(2)
                wav_file.setframerate(sample_rate)
                num_samples = int(sample_rate * duration)
                for i in range(num_samples):
                    volume = 15000 * (1 - i / num_samples)
                    wav_file.writeframes(struct.pack('<h', int(volume * random.uniform(-1, 1))))
            with open(fname, 'wb') as f:
                f.write(buf.getvalue())
            return fname
        except Exception:
            return None

    @staticmethod
    def create_truncated(source_fname, name, fraction=0.5):
        fname = os.path.join(os.path.dirname(os.path.abspath(__file__)), f"sys_{name}.wav")
        try:
            if os.path.exists(fname) and os.path.getsize(fname) > 0:
                return fname
        except OSError:
            pass
        if not source_fname or not os.path.exists(source_fname):
            return None
        try:
            with wave.open(source_fname, 'rb') as src:
                nchannels = src.getnchannels()
                sampwidth = src.getsampwidth()
                framerate = src.getframerate()
                frames = src.readframes(src.getnframes())
            frame_size = max(1, sampwidth * nchannels)
            cut = int(len(frames) * fraction)
            cut -= cut % frame_size
            if cut <= 0:
                return None
            buf = io.BytesIO()
            with wave.open(buf, 'wb') as dst:
                dst.setnchannels(nchannels)
                dst.setsampwidth(sampwidth)
                dst.setframerate(framerate)
                dst.writeframes(frames[:cut])
            with open(fname, 'wb') as f:
                f.write(buf.getvalue())
            return fname
        except Exception:
            return None


