            x_center = self.width / 2.0
        base_x = x_center - total_w / 2.0
        self._draw_text(cycles_str, base_x, y_center, f_size, group=group)
        fx = base_x + cyc_tex.size[0] + 6
        self._draw_floppy(fx + icon_size / 2, y_center, icon_size, digit=digit, group=group)
        self._draw_text(pct_str, fx + icon_size + 6, y_center, f_size, group=group)

    def _update_hud_fps(self):
        if not hasattr(self, '_hud_fps_rect') or not hasattr(self, 'f_size'):
            return
        fps_val = int(Clock.get_fps())
        fps_rounded = (fps_val // 5) * 5
        if self._last_fps_shown == fps_rounded:
            return
        self._last_fps_shown = fps_rounded
        sw, sh = self.width, self.height
        is_landscape = (sw > sh)
        f_size = self.f_size
        fps_text = f"FPS {fps_rounded}"
        fps_tex = get_text_texture(fps_text, f_size)
        if not is_landscape:
            if not hasattr(self, 'maze_top'):
                return
            row_h = self.row_h
            top_row_cy = self.maze_top + self.hud_h - row_h / 2
            level_tex = get_text_texture(f"Level-{getattr(self, 'level', 1)}", f_size)
            doors_label_tex = get_text_texture("Doors:", f_size)
            doors_num_tex = get_text_texture(str(getattr(self, 'num_doors', 0)), f_size)
            end_x = (15 + level_tex.size[0] + 20
                     + doors_label_tex.size[0] + 6 + doors_num_tex.size[0] + 15)
            self._hud_fps_rect.pos = (end_x, top_row_cy - fps_tex.size[1] / 2)
        else:
            row_h = self.row_h
            left_w = max(160, int(sh * 0.38))
            cx = left_w / 2.0
            fps_y = sh - 25 - row_h * 1.2 * 2
            self._hud_fps_rect.pos = (cx - fps_tex.size[0] / 2, fps_y - fps_tex.size[1] / 2)
        self._hud_fps_rect.size = fps_tex.size
        self._hud_fps_rect.texture = fps_tex

    def enemy_tick(self):
        app = App.get_running_app()
        was_sleeping = set()
        for en in self.enemies:
            sc = en.get('sleep_counter', 0)
            if sc > 0:
                was_sleeping.add(id(en))
                en['sleep_counter'] = sc - 1
                en['next_cell'] = en['current_cell']
                en['_just_woke'] = (sc == 1)
                if sc == 1:
                    self._update_sleep_visual(en)
                    if en['last_dir'] != VEC_ZERO:
                        en['dir'] = Vector(en['last_dir'].x, en['last_dir'].y)
                    else:
                        en['dir'] = VEC_ZERO
                else:
                    en['dir'] = VEC_ZERO
            else:
                en['_just_woke'] = False
        any_sleeping = len(was_sleeping) > 0

        for en in self.enemies:
            if id(en) in was_sleeping:
                en['_just_moved'] = False
                continue
            old = en['current_cell']
            en['current_cell'] = en['next_cell']
            en['grid'] = Vector(*en['current_cell'])
            en['_just_moved'] = (old != en['current_cell'])
            if en['_just_moved']:
                key = (old, en['current_cell']) if old < en['current_cell'] else (en['current_cell'], old)
                en['pause_after_door'] = (key in self.doors)
            else:
                en['pause_after_door'] = False

        enemy_positions = {en['current_cell'] for en in self.enemies}

        pre_sleep_active = [en for en in self.enemies if id(en) not in was_sleeping]
        intent_active = [en for en in pre_sleep_active
                         if not en.get('pause_after_door', False)]
        intents = self._resolve_enemy_intents(intent_active)

        cycle_completed = False
        if not any_sleeping and self.sleep_cycle_set:
            reverse_order = (self.full_sleep_cycles % 2 == 1)
            ordered = sorted(self.sleep_cycle_set, reverse=reverse_order)
            if ordered:
                next_idx = ordered[0]
                chosen = None
                for en in pre_sleep_active:
                    if en['idx'] == next_idx:
                        chosen = en
                        break
                if chosen is not None:
                    chosen['sleep_counter'] = 2
                    chosen['dir'] = VEC_ZERO
                    chosen['next_cell'] = chosen['current_cell']
                    chosen['_just_moved'] = True
                    chosen['pause_after_door'] = False
                    self._update_sleep_visual(chosen)
                    self.sleep_cycle_set.discard(chosen['idx'])
                    reset_done = False
                    if not self.sleep_cycle_set:
                        self.sleep_cycle_set = set(e['idx'] for e in self.enemies)
                        self.full_sleep_cycles += 1
                        cycle_completed = True
                        reset_done = True
                    if reset_done:
                        for en2 in self.enemies:
                            if en2.get('is_carrier', False):
                                self._update_carrier_star_visual(en2)
                    elif chosen.get('is_carrier', False):
                        self._update_carrier_star_visual(chosen)
                    was_sleeping.add(id(chosen))

        union_vis = set()
        for en in self.enemies:
            if id(en) not in was_sleeping:
                if en.get('pause_after_door', False):
                    en['next_cell'] = en['current_cell']
                    en['pause_after_door'] = False
                else:
                    tgt = intents.get(en['idx'])
                    if tgt is None:
                        en['next_cell'] = en['current_cell']
                    elif tgt == en['current_cell']:
                        en['dir'] = VEC_ZERO
                        en['next_cell'] = en['current_cell']
                    else:
                        new_dir = Vector(tgt[0] - en['current_cell'][0], tgt[1] - en['current_cell'][1])
                        en['dir'] = new_dir
                        en['last_dir'] = new_dir
                        en['next_cell'] = tgt
            en['visible_cells'] = self.get_enemy_los(en, enemy_positions)
            union_vis |= en['visible_cells']

        self.union_visible_cells = union_vis

        self.last_p_cells = self.get_occupied_cells(self.p_pixel)
        if len(self.last_p_cells) == 1:
            cell = next(iter(self.last_p_cells))
            if cell in union_vis:
                self.active = False
                if self.snd_lose and not app.is_muted: self.snd_lose.play()
                app.root.get_screen('game').show_overlay('lose')
                return

        just_dropped_ids = set()
        for en in self.enemies:
            if not en.get('is_carrier', False):
                continue
            if en.get('sleep_counter', 0) > 0:
                continue
            if en['idx'] in self.sleep_cycle_set:
                continue
            if en['current_cell'] not in self.dead_ends_set:
                continue
            self._drop_button(en)
            just_dropped_ids.add(id(en))

        for en in self.enemies:
            if id(en) in was_sleeping:
                continue
            if not en.get('_just_moved', False):
                continue
            if en.get('is_carrier', False):
                continue
            if id(en) in just_dropped_ids:
                continue
            if en['current_cell'] in self.ground_buttons:
                self._pickup_button(en)
                self._refresh_player_dists()
                self._update_compass()

        self.enemy_tick_counter += 1

        if cycle_completed and (self.full_sleep_cycles % self._autosave_every_n == 0):
            self.save_game_state()
            self._flash_checkpoint()
            if self.snd_checkpoint and not app.is_muted:
                self.snd_checkpoint.play()

    def update(self, dt):
        if not self.active: return
        app = App.get_running_app()
        if getattr(app, 'is_paused', False):
            self._show_pause_label(True)
            return
        self._show_pause_label(False)
        self.time_accumulator = min(self.time_accumulator + dt, 0.25)
        sub_steps, state_dirty = 0, False

        while self.time_accumulator >= self.dt_step and sub_steps < 3:
            self.time_accumulator -= self.dt_step
            self.logic_steps += 1
            sub_steps += 1
            if not self.active: break
            self.last_p_cells = self.get_occupied_cells(self.p_pixel)

            if len(self.last_p_cells) == 1:
                cell = next(iter(self.last_p_cells))
                if cell in self.union_visible_cells:
                    self.active = False
                    if self.snd_lose and not app.is_muted: self.snd_lose.play()
                    app.root.get_screen('game').show_overlay('lose')
                    return

            _e_prog = max(0.0, min(1.0, self.enemy_time / self.enemy_step_interval)) if self.enemy_step_interval > 0 else 1.0
            TOUCH_SQ = (CELL_SIZE * 0.85) ** 2
            for en in self.enemies:
                ccx, ccy = en['current_cell']
                ncx, ncy = en['next_cell']
                ex = ccx * TOTAL_STEP + (ncx - ccx) * TOTAL_STEP * _e_prog
                ey = ccy * TOTAL_STEP + (ncy - ccy) * TOTAL_STEP * _e_prog
                dx, dy = self.p_pixel.x - ex, self.p_pixel.y - ey
                if dx * dx + dy * dy < TOUCH_SQ:
                    self.active = False
                    if self.snd_lose and not app.is_muted: self.snd_lose.play()
                    app.root.get_screen('game').show_overlay('lose')
                    return

            target = self.player_grid * TOTAL_STEP
            was_moving = self.p_dir != VEC_ZERO
            dxt = self.p_pixel.x - target.x
            dyt = self.p_pixel.y - target.y
            recalc_dists = False

            if dxt * dxt + dyt * dyt <= self.p_speed ** 2:
                self.p_pixel = Vector(target)
                gx, gy = int(self.player_grid.x), int(self.player_grid.y)
                just_picked = False
                if self.player_last_cell != (gx, gy):
                    self.player_last_cell = (gx, gy)
                    recalc_dists = True
                    redraw_int = False
                    if (gx, gy) in self.ground_buttons:
                        cid = self.ground_buttons.pop((gx, gy))
                        self.collected_trophies.append(cid)
                        self.collected_count += 1
                        state_dirty, redraw_int, just_picked = True, True, True
                        if self.snd_pickup and not app.is_muted:
                            self.snd_pickup.play()
                        self._check_hatch_open(app)
                    if redraw_int:
                        if self.IS_LARGE:
                            if self.last_drawn_chunk is not None:
                                self.draw_interactive(*self.last_drawn_chunk)
                        else:
                            self.interactive_redraw_needed = True
                    if self.hatch_open and (gx, gy) == self.hatch_pos:
                        if (gx, gy) in self.union_visible_cells:
                            self.active = False
                            if self.snd_lose and not app.is_muted: self.snd_lose.play()
                            app.root.get_screen('game').show_overlay('lose')
                            return
                        self.active = False
                        if self.snd_victory and not app.is_muted: self.snd_victory.play()
                        self.player_group.clear()
                        self.hatch_open = False
                        if self.IS_LARGE:
                            self.draw_interactive(gx, gy)
                        else:
                            self.draw_interactive()
                        app.root.get_screen('game').show_overlay('win')
                        return

                avail = self.get_avail(gx, gy)
                has_door = self._has_adjacent_door(gx, gy)
                if self.p_dir != VEC_ZERO:
                    if self.next_dir is not None and self.next_dir != self.p_dir:
                        self.p_dir, self.next_dir = VEC_ZERO, None
                    elif has_door:
                        self.p_dir = VEC_ZERO
                    else:
                        fps = [d for d in avail if d != -self.p_dir]
                        self.p_dir = VEC_ZERO if len(avail) > 2 else (
                            fps[0] if len(avail) == 2 and len(fps) == 1 else VEC_ZERO)
                if self.p_dir == VEC_ZERO and self.next_dir in avail:
                    self.p_dir = self.next_dir
                self.next_dir = None

                if self.p_dir != VEC_ZERO:
                    ngx, ngy = gx + int(self.p_dir.x), gy + int(self.p_dir.y)
                    target_cell = (ngx, ngy)
                    prog = max(0.0, min(1.0, self.enemy_time / self.enemy_step_interval)) if self.enemy_step_interval > 0 else 1.0
                    blocked = False
                    for en in self.enemies:
                        cc, nc = en['current_cell'], en['next_cell']
                        if cc == target_cell:
                            if nc == target_cell or prog < 0.3:
                                blocked = True
                                break
                        elif nc == target_cell:
                            blocked = True
                            break
                    if blocked:
                        self.p_dir = VEC_ZERO
                        self.next_dir = None

                if was_moving and self.p_dir == VEC_ZERO and not just_picked and self.snd_stop and not app.is_muted:
                    self.snd_stop.play()
                if self.p_dir != VEC_ZERO:
                    self.last_p_dir = Vector(self.p_dir)
                    self.player_grid += self.p_dir
                    self._refresh_player_dists()
                    self._update_compass()
            else:
                self.p_pixel += (target - self.p_pixel).normalize() * self.p_speed

            if recalc_dists:
                self._refresh_player_dists()
                self._update_compass()
                state_dirty = True

        if sub_steps >= 3:
            self.time_accumulator = 0.0
        if not self.active: return

        self.enemy_time += min(dt, 0.5)
        ticked = False
        while self.enemy_time >= self.enemy_step_interval:
            self.enemy_time -= self.enemy_step_interval
            self.enemy_tick()
            ticked = True
            if not self.active:
                gx2, gy2 = int(self.player_grid.x), int(self.player_grid.y)
                if self.IS_LARGE:
                    self.draw_entities(gx2, gy2)
                else:
                    self.draw_entities()
                return

        gx, gy = int(self.player_grid.x), int(self.player_grid.y)
        if self.IS_LARGE:
            if self.last_drawn_chunk != (gx, gy):
                self.last_drawn_chunk = (gx, gy)
                self.draw_static(gx, gy)
                self.draw_interactive(gx, gy)
                self.draw_doors(gx, gy)
            if self.interactive_redraw_needed:
                self.interactive_redraw_needed = False
                self.draw_interactive(gx, gy)
            self.update_camera()
            self.draw_entities(gx, gy)
        else:
            if self.interactive_redraw_needed:
                self.interactive_redraw_needed = False
                self.draw_interactive()
            self.update_camera()
            self.draw_entities()

        if ticked or state_dirty:
            self._update_hud_state()

    def _draw_player_eyes(self):
        self.p_body_inst.pos = (self.p_pixel.x, self.p_pixel.y)
        pcx, pcy = self.p_pixel.x + CELL_SIZE / 2, self.p_pixel.y + CELL_SIZE / 2
        dx, dy = self.last_p_dir.x, self.last_p_dir.y
        ef, es, er = 10, 6, 3
        lx, ly = pcx + dx * ef - dy * es, pcy + dy * ef + dx * es
        rx, ry = pcx + dx * ef + dy * es, pcy + dy * ef - dx * es
        self.p_left_eye_inst.pos = (lx - er, ly - er)
        self.p_left_eye_inst.size = (er * 2, er * 2)
        self.p_right_eye_inst.pos = (rx - er, ry - er)
        self.p_right_eye_inst.size = (er * 2, er * 2)

        if self.IS_LARGE:
            cd = getattr(self, 'compass_dir', None)
            if cd is not None:
                cdx, cdy = cd
                r = CELL_SIZE / 2.0
                marker_size = 10
                marker_thick = 4
                if cdx == 0 and cdy == 1:
                    mx, my = pcx - marker_size/2, pcy + r - marker_thick
                    mw, mh = marker_size, marker_thick
                elif cdx == 0 and cdy == -1:
                    mx, my = pcx - marker_size/2, pcy - r
                    mw, mh = marker_size, marker_thick
                elif cdx == 1 and cdy == 0:
                    mx, my = pcx + r - marker_thick, pcy - marker_size/2
                    mw, mh = marker_thick, marker_size
                elif cdx == -1 and cdy == 0:
                    mx, my = pcx - r, pcy - marker_size/2
                    mw, mh = marker_thick, marker_size
                else:
                    mx, my, mw, mh = -1000, -1000, 0, 0
                self.p_compass_color.rgba = (0, 0, 0, 1)
                self.p_compass_rect.pos = (mx, my)
                self.p_compass_rect.size = (mw, mh)
            else:
                self.p_compass_color.a = 0.0
        else:
            self.p_compass_color.a = 0.0

    def _pick_balanced_spawns(self, num_per_color, max_colors=5):
        by_color = {}
        center_dist = self.get_topological_distances(self.hatch_pos)
        for de in self.dead_ends_set:
            edge = self.door_edges.get(de)
            if edge is None:
                continue
            cid = self.door_color_id.get(edge)
            if cid is None or cid >= max_colors:
                continue
            by_color.setdefault(cid, []).append(de)
        if not by_color:
            return []
        min_avail = min(len(lst) for lst in by_color.values())
        n = min(num_per_color, min_avail)
        if n <= 0:
            return []
        all_picks = []
        for cid in sorted(by_color.keys()):
            des = by_color[cid]
            des_sorted = sorted(des, key=lambda d: (-center_dist.get(d, 0), d))
            picked = des_sorted[:n]
            for p in picked:
                all_picks.append((p, cid, center_dist.get(p, 0)))

        final_picks = []
        neighbor_counts = {}
        for (pos, cid, dist) in all_picks:
            temp = dict(neighbor_counts)
            for nb in self.adj_list.get(pos, []):
                temp[nb] = temp.get(nb, 0) + 1
            if any(c > 2 for c in temp.values()):
                continue
            final_picks.append((pos, cid, dist))
            for nb in self.adj_list.get(pos, []):
                neighbor_counts[nb] = neighbor_counts.get(nb, 0) + 1
        return final_picks

    def _prepare_cell_avails(self):
        self.cell_avails = {(x, y): [Vector(v) for d, v in DIRS.items() if self.maze_data[y][x][d] == 0]
                            for y in range(self.grid_h) for x in range(self.grid_w)}
        self.cell_avails_by_color = {}
        for cid in range(self.num_colors):
            dd = {}
            for cell, dirs in self.cell_avails.items():
                filtered = []
                for v in dirs:
                    nxt = (cell[0] + int(v.x), cell[1] + int(v.y))
                    edge = (cell, nxt) if cell < nxt else (nxt, cell)
                    dc = self.door_color_id.get(edge)
                    if dc is None or dc == cid:
                        filtered.append(v)
                dd[cell] = filtered
            self.cell_avails_by_color[cid] = dd


def _compute_from_cell(player_grid, p_dir, grid_w, grid_h):
    fx = int(player_grid.x - p_dir.x)
    fy = int(player_grid.y - p_dir.y)
    if 0 <= fx < grid_w and 0 <= fy < grid_h:
        return (fx, fy)
    return (int(player_grid.x), int(player_grid.y))


class GameWorldStatic(GameWorldBase):
    SAVE_VERSION = 3
    GRID_W = MAZE_W
    GRID_H = MAZE_H
    WORLD_DIM = MAZE_WORLD_DIM
    WORLD_CX = MAZE_WORLD_CX
    MAX_ENEMIES = NUM_ENEMIES
    PATTERN_POOL = None

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.active = True
        self.maze_scale = 1.0
        self.maze_top = 0.0
        self.maze_bottom = 0.0
        self.time_accumulator = 0.0
        self.logic_steps = 0
        self.dt_step = 1.0 / 60.0
        self._init_sounds()
        self.union_visible_cells = set()

        app = App.get_running_app()
        data = app.pre_gen_data
        self.maze_data = data['grid']
        self.grid_w, self.grid_h = self.GRID_W, self.GRID_H
        self.level = data.get('level', 1)

        self.adj_list = {(x, y): [(x + dx, y + dy) for d, (dx, dy) in DIRS.items()
                                  if self.maze_data[y][x][d] == 0]
                         for y in range(self.grid_h) for x in range(self.grid_w)}
        self.dead_ends_set = set(data.get('dead_ends', []))
        self.target_de = len(self.dead_ends_set)

        self._prepare_door_data()
        self._prepare_cell_avails()

        self.p_speed = 1.1
        p_spawn = data['p_spawn']
        self.hatch_pos = tuple(p_spawn)

        self._build_canvas()
        self.level_group = InstructionGroup()
        self.canvas.add(self.level_group)
        self._init_checkpoint_label()
        self._init_pause_label()

        self.enemies = []
        save_data = self._load_save_data()
        self.hatch_open = False
        self.collected_trophies = []
        self.collected_count = 0
        self.ground_buttons = {}
        self.full_sleep_cycles = 0

        if save_data:
            self.hatch_open = save_data.get('hatch_open', False)
            self.collected_trophies = list(save_data.get('collected_trophies', []))
            self.collected_count = len(self.collected_trophies)
            self.ground_buttons = dict(save_data.get('ground_buttons', {}))
            self.full_sleep_cycles = int(save_data.get('full_sleep_cycles', 0))
            self.player_grid = Vector(save_data['player_grid_x'], save_data['player_grid_y'])
            self.p_pixel = Vector(save_data['p_pixel_x'], save_data['p_pixel_y'])
            self.p_dir = Vector(save_data['p_dir_x'], save_data['p_dir_y'])
            self.last_p_dir = Vector(save_data['last_p_dir_x'], save_data['last_p_dir_y'])
            for es in save_data['enemies']:
                self.enemies.append(self._make_enemy_dict(es['idx'], es, saved=True))
            self.sleep_cycle_set = set(save_data.get('sleep_cycle_set',
                                                      set(e['idx'] for e in self.enemies)))
        else:
            self.player_grid = Vector(p_spawn[0], p_spawn[1])
            self.p_pixel = self.player_grid * TOTAL_STEP
            self.p_dir = VEC_ZERO
            self.last_p_dir = Vector(0, 1)

            num_per_color = max(1, self.MAX_ENEMIES // self.num_colors)
            picks = self._pick_balanced_spawns(num_per_color, max_colors=self.num_colors)
            by_color = {}
            for (pos, cid, dist) in picks:
                by_color.setdefault(cid, []).append((pos, dist))
            for cid in by_color:
                by_color[cid].sort(key=lambda x: -x[1])

            pools_by_color = self.PATTERN_POOL or [list(range(len(DOT_PATTERNS))) for _ in range(5)]
            slot_idx = 0
            for cid in sorted(by_color.keys()):
                color_pool = pools_by_color[cid] if cid < len(pools_by_color) else pools_by_color[0]
                for i, (pos, dist) in enumerate(by_color[cid]):
                    rule = 'right' if i % 2 == 0 else 'left'
                    is_carrier = (i == 0)
                    pat_idx = color_pool[i % len(color_pool)] if color_pool else 0
                    prof = {'pattern_idx': pat_idx, 'turn_rule': rule,
                            'speed': 0.5, 'color': WALL_COLOR}
                    self.enemies.append(self._make_enemy_dict(
                        slot_idx, prof, saved=False, e_spawn=pos,
                        color_id=cid, is_carrier=is_carrier))
                    slot_idx += 1

            self.sleep_cycle_set = set(e['idx'] for e in self.enemies)

        for en in self.enemies:
            if en.get('is_carrier', False):
                self._update_carrier_star_visual(en)

        cc = [0] * self.num_colors
        for en in self.enemies:
            cid = en.get('color_id', 0)
            if 0 <= cid < self.num_colors:
                cc[cid] += 1
        self._color_counts_tuple = tuple(cc)

        ref_speed = self.enemies[0]['speed'] if self.enemies else 0.5
        self.enemy_step_interval = TOTAL_STEP / (ref_speed * 60.0)
        self.enemy_time = save_data.get('enemy_time', 0.0) if save_data else self.enemy_step_interval
        self.enemy_tick_counter = 0
        self.next_dir = None
        self.player_last_cell = _compute_from_cell(self.player_grid, self.p_dir,
                                                  self.grid_w, self.grid_h)
        self._refresh_player_dists()
        self._update_compass()

        if not self.hatch_open and self.collected_count >= BUTTONS_TO_OPEN:
            self.hatch_open = True

        self.current_joy_dir = None
        self.last_p_cells = self.get_occupied_cells(self.p_pixel)
        self.interactive_redraw_needed = False

        if save_data:
            self._restore_union_visible_cells()

        self.bind(size=self.trigger_static_redraw, pos=self.trigger_static_redraw)
        self._update_event = Clock.schedule_interval(self.update, 1 / 60.0)

    def update_transforms(self):
        sw, sh = self.width, self.height
        if sw <= 0 or sh <= 0:
            return
        is_landscape = (sw > sh)
        if not is_landscape:
            f_size, row_h, trophy_h, autosave_h, hud_h = _compute_hud_dims(sw, False)
            maze_size = min(sw, sh - hud_h)
            maze_top = sh - hud_h
            maze_bottom = maze_top - maze_size
            if maze_bottom < MIN_JOY_SIZE:
                maze_size = max(MIN_JOY_SIZE, sh - hud_h - MIN_JOY_SIZE)
                maze_size = min(maze_size, sw)
                maze_top = sh - hud_h
                maze_bottom = maze_top - maze_size
            maze_left = (sw - maze_size) / 2.0
        else:
            f_size, row_h, trophy_h, autosave_h, hud_h = _compute_hud_dims(sh, False)
            left_w = max(160, int(sh * 0.38))
            right_w = max(MIN_JOY_SIZE, int(sh * 0.4))
            maze_size = min(sh, max(MIN_JOY_SIZE, sw - left_w - right_w))
            maze_bottom = (sh - maze_size) / 2.0
            maze_top = maze_bottom + maze_size
            maze_left = left_w + (sw - left_w - right_w - maze_size) / 2.0

        self.f_size = f_size
        self.row_h = row_h
        self.trophy_h = trophy_h
        self.autosave_h = autosave_h
        self.hud_h = hud_h
        self.maze_size = maze_size
        self.maze_top = maze_top
        self.maze_bottom = maze_bottom
        self.maze_scale = maze_size / self.WORLD_DIM
        self.maze_cx = maze_left + maze_size / 2.0 if is_landscape else sw / 2.0
        self.maze_center_y = maze_bottom + maze_size / 2.0

        self.stencil_rect1.pos = (maze_left, maze_bottom)
        self.stencil_rect1.size = (maze_size, maze_size)
        self.stencil_rect2.pos = (maze_left, maze_bottom)
        self.stencil_rect2.size = (maze_size, maze_size)

    def update_camera(self):
        if self._cam_translate is None:
            self._cam_translate = Translate(0, 0, 0)
            self._cam_scale = Scale(1, 1, 1)
            self._cam_offset = Translate(0, 0, 0)
            self.matrix_group.add(self._cam_translate)
            self.matrix_group.add(self._cam_scale)
            self.matrix_group.add(self._cam_offset)
        self._cam_translate.x = self.maze_cx
        self._cam_translate.y = self.maze_center_y
        self._cam_scale.x = self.maze_scale
        self._cam_scale.y = self.maze_scale
        self._cam_offset.x = -self.WORLD_CX
        self._cam_offset.y = -self.WORLD_CX

    def trigger_static_redraw(self, *args):
        self.update_transforms()
        self.draw_level()
        self.draw_static()
        self.draw_interactive()
        self.draw_doors()
        self.update_camera()
        self.draw_entities()
        self.hud_static_state = None
        self.hud_dynamic_state = None
        self._last_fps_shown = None
        self._update_hud_state()
        _schedule_canvas_refresh()

    def draw_level(self):
        self.level_group.clear()
        if not hasattr(self, 'maze_top'): return
        sw, sh = self.width, self.height
        is_landscape = (sw > sh)
        f_size = self.f_size
        if not is_landscape:
            tex = get_text_texture(f"Level-{self.level}", f_size)
            top_row_cy = self.maze_top + self.hud_h - self.row_h / 2
            tx = 15
            ty = top_row_cy - tex.size[1] / 2
            self.level_group.add(Color(*TEXT_COLOR, 1))
            self.level_group.add(Rectangle(texture=tex, pos=(tx, ty), size=tex.size))

    def draw_static(self):
        if getattr(self, '_static_built', False):
            return
        self._static_built = True
        self.static_group.clear()
        self.static_group.add(Color(0.05, 0.05, 0.05))
        self.static_group.add(Rectangle(size=(self.grid_w * TOTAL_STEP, self.grid_h * TOTAL_STEP), pos=(0, 0)))
        if self.pocket_cells:
            self.static_group.add(Color(*POCKET_FLOOR_COLOR))
            for (cx_, cy_) in self.pocket_cells:
                if 0 <= cx_ < self.grid_w and 0 <= cy_ < self.grid_h:
                    px_ = cx_ * TOTAL_STEP
                    py_ = cy_ * TOTAL_STEP
                    self.static_group.add(Rectangle(pos=(px_, py_), size=(CELL_SIZE, CELL_SIZE)))

                if (cx_ + 1, cy_) in self.pocket_cells:
                    self.static_group.add(Rectangle(pos=(cx_ * TOTAL_STEP + CELL_SIZE, cy_ * TOTAL_STEP), size=(WALL_THICK, CELL_SIZE)))
                if (cx_, cy_ + 1) in self.pocket_cells:
                    self.static_group.add(Rectangle(pos=(cx_ * TOTAL_STEP, cy_ * TOTAL_STEP + CELL_SIZE), size=(CELL_SIZE, WALL_THICK)))

                for dx_, dy_ in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nb = (cx_ + dx_, cy_ + dy_)
                    edge = ((cx_, cy_), nb) if (cx_, cy_) < nb else (nb, (cx_, cy_))
                    if edge in self.doors:
                        if dx_ == 1:
                            self.static_group.add(Rectangle(pos=(cx_ * TOTAL_STEP + CELL_SIZE, cy_ * TOTAL_STEP), size=(WALL_THICK / 2.0, CELL_SIZE)))
                        elif dx_ == -1:
                            self.static_group.add(Rectangle(pos=(cx_ * TOTAL_STEP - WALL_THICK / 2.0, cy_ * TOTAL_STEP), size=(WALL_THICK / 2.0, CELL_SIZE)))
                        elif dy_ == 1:
                            self.static_group.add(Rectangle(pos=(cx_ * TOTAL_STEP, cy_ * TOTAL_STEP + CELL_SIZE), size=(CELL_SIZE, WALL_THICK / 2.0)))
                        elif dy_ == -1:
                            self.static_group.add(Rectangle(pos=(cx_ * TOTAL_STEP, cy_ * TOTAL_STEP - WALL_THICK / 2.0), size=(CELL_SIZE, WALL_THICK / 2.0)))

        self.static_group.add(Color(*WALL_COLOR))
        for y in range(self.grid_h):
            for x in range(self.grid_w):
                m, px, py = self.maze_data[y][x], x * TOTAL_STEP, y * TOTAL_STEP
                if m['N']:
                    self.static_group.add(Rectangle(pos=(px - WALL_THICK, py + CELL_SIZE),
                                                    size=(TOTAL_STEP + WALL_THICK, WALL_THICK)))
                if m['W']:
                    self.static_group.add(Rectangle(pos=(px - WALL_THICK, py - WALL_THICK),
                                                    size=(WALL_THICK, TOTAL_STEP + WALL_THICK)))
                if y == 0 and m['S']:
                    self.static_group.add(Rectangle(pos=(px - WALL_THICK, py - WALL_THICK),
                                                    size=(TOTAL_STEP + WALL_THICK, WALL_THICK)))
                if x == self.grid_w - 1 and m['E']:
                    self.static_group.add(Rectangle(pos=(px + CELL_SIZE, py - WALL_THICK),
                                                    size=(WALL_THICK, TOTAL_STEP + WALL_THICK)))

    def draw_doors(self):
        self.doors_group.clear()
        DOOR_W = WALL_THICK / 3.0
        half = CELL_SIZE / 2.0
        if not self.color_palette: return
        for (a, b) in self.doors:
            cid = self.door_color_id.get((a, b))
            if cid is None: continue
            r, g, bl = self.color_palette[cid]
            self.doors_group.add(Color(r, g, bl, 1.0))
            cx = (a[0] + b[0]) * 0.5 * TOTAL_STEP + CELL_SIZE / 2.0
            cy = (a[1] + b[1]) * 0.5 * TOTAL_STEP + CELL_SIZE / 2.0
            if a[0] != b[0]:
                self.doors_group.add(Rectangle(pos=(cx - DOOR_W / 2, cy - half), size=(DOOR_W, half * 2)))
            else:
                self.doors_group.add(Rectangle(pos=(cx - half, cy - DOOR_W / 2), size=(half * 2, DOOR_W)))

    def draw_interactive(self, *args):
        self.interactive_group.clear()
        hx, hy = self.hatch_pos
        hx_px, hy_px = hx * TOTAL_STEP, hy * TOTAL_STEP
        hs = CELL_SIZE * 0.9
        off = (CELL_SIZE - hs) / 2
        cx, cy = hx_px + CELL_SIZE / 2, hy_px + CELL_SIZE / 2
        r = hs / 2
        if not self.hatch_open:
            self.interactive_group.add(Color(0.4, 0.4, 0.4, 0.6))
            self.interactive_group.add(Ellipse(pos=(hx_px + off, hy_px + off), size=(hs, hs)))
            self.interactive_group.add(Color(0.2, 0.2, 0.2, 0.8))
            self.interactive_group.add(Line(circle=(cx, cy, r), width=1.5))
            c45 = math.cos(math.radians(45)) * r
            self.interactive_group.add(Line(points=[cx - c45, cy - c45, cx + c45, cy + c45], width=1.5))
            self.interactive_group.add(Line(points=[cx - c45, cy + c45, cx + c45, cy - c45], width=1.5))
        else:
            self.interactive_group.add(Color(0.05, 0.05, 0.05, 0.6))
            self.interactive_group.add(Ellipse(pos=(hx_px + off, hy_px + off), size=(hs, hs)))
            self.interactive_group.add(Color(0, 1, 0.5, 0.8))
            self.interactive_group.add(Line(circle=(cx, cy, r), width=1.5))

        star_size = CELL_SIZE - 4
        for pos, cid in self.ground_buttons.items():
            bx, by = pos
            rgb = self.color_palette[cid] if 0 <= cid < len(self.color_palette) else GREEN_BUTTON_COLOR
            scx = bx * TOTAL_STEP + CELL_SIZE / 2
            scy = by * TOTAL_STEP + CELL_SIZE / 2
            _draw_star(self.interactive_group, scx, scy, star_size, rgb)

    def draw_entities(self, *args):
        self._draw_player_eyes()
        progress = 1.0
        if self.enemy_step_interval > 0:
            progress = max(0.0, min(1.0, self.enemy_time / self.enemy_step_interval))
        for en in self.enemies:
            ccx, ccy = en['current_cell']
            ncx, ncy = en['next_cell']
            ex = ccx * TOTAL_STEP + (ncx - ccx) * TOTAL_STEP * progress
            ey = ccy * TOTAL_STEP + (ncy - ccy) * TOTAL_STEP * progress
            en['pixel'].x = ex
            en['pixel'].y = ey
            ecx, ecy = ex + CELL_SIZE / 2, ey + CELL_SIZE / 2
            en['g_translate'].x = ecx
            en['g_translate'].y = ecy
            vdx, vdy = en['dir'].x, en['dir'].y
            if vdx == 0 and vdy == 0:
                vdx, vdy = en['last_dir'].x, en['last_dir'].y
            if (vdx, vdy) != en['last_drawn_dir']:
                en['last_drawn_dir'] = (vdx, vdy)
                self._apply_enemy_rotation(en, vdx, vdy)

    def draw_hud_static(self):
        self.hud_static_group.clear()
        sw, sh = self.width, self.height
        is_landscape = (sw > sh)
        if not is_landscape:
            if not hasattr(self, 'maze_top'): return
            maze_top = self.maze_top
            f_size = self.f_size
            row_h = self.row_h
            top_row_cy = maze_top + self.hud_h - row_h / 2

            level_tex = get_text_texture(f"Level-{self.level}", f_size)
            doors_x = 15 + level_tex.size[0] + 20
            dw = self._draw_text("Doors:", doors_x, top_row_cy, f_size, group=self.hud_static_group)
            self._draw_text(str(self.num_doors), doors_x + dw + 6, top_row_cy, f_size, group=self.hud_static_group)

            icon_r = min(f_size * 0.55, row_h * 0.4)
            trophy_top_y = maze_top + self.hud_h - row_h
            self._draw_trophy_board(trophy_top_y, icon_r, group=self.hud_static_group)
        else:
            f_size = self.f_size
            row_h = self.row_h
            left_w = max(160, int(sh * 0.38))
            cx = left_w / 2.0
            cur_y = sh - 25

            tex_lvl = get_text_texture(f"Level-{self.level}", f_size)
            self.hud_static_group.add(Color(*TEXT_COLOR, 1))
            self.hud_static_group.add(Rectangle(texture=tex_lvl, pos=(cx - tex_lvl.size[0]/2, cur_y - tex_lvl.size[1]/2), size=tex_lvl.size))
            cur_y -= row_h * 1.2

            tex_doors = get_text_texture(f"Doors: {self.num_doors}", f_size)
            self.hud_static_group.add(Color(*TEXT_COLOR, 1))
            self.hud_static_group.add(Rectangle(texture=tex_doors, pos=(cx - tex_doors.size[0]/2, cur_y - tex_doors.size[1]/2), size=tex_doors.size))
            cur_y -= row_h * 1.2

            icon_r = min(f_size * 0.55, row_h * 0.4)
            trophy_cell = icon_r * TROPHY_CELL_MULT
            trophy_gap = icon_r * TROPHY_GAP_MULT
            board_w = 5 * trophy_cell + 4 * trophy_gap
            board_scale = min(1.0, (left_w - 20) / board_w)
            trophy_y = cur_y - trophy_cell * board_scale / 2
            base_x = cx - (board_w * board_scale) / 2
            for i in range(5):
                x = base_x + i * (trophy_cell + trophy_gap) * board_scale
                scx = x + (trophy_cell * board_scale) / 2
                scy = trophy_y
                sz = trophy_cell * board_scale
                if i < len(self.collected_trophies):
                    cid = self.collected_trophies[i]
                    rgb = self.color_palette[cid] if 0 <= cid < len(self.color_palette) else (0.5, 0.5, 0.5)
                    _draw_star(self.hud_static_group, scx, scy, sz, rgb)
                else:
                    _draw_star_outline(self.hud_static_group, scx, scy, sz, (*TEXT_COLOR, 0.7), width=1.0)

    def draw_hud_dynamic(self):
        self.hud_dynamic_group.clear()
        sw, sh = self.width, self.height
        is_landscape = (sw > sh)
        if not is_landscape:
            if not hasattr(self, 'maze_top'): return
            maze_top = self.maze_top
            row_h = self.row_h
            autosave_h = getattr(self, 'autosave_h', int(row_h * 0.9))
            row3_cy = maze_top + autosave_h / 2
            self._draw_autosave_counter(row3_cy, x_center=sw * 0.18, group=self.hud_dynamic_group)
        else:
            f_size = self.f_size
            row_h = self.row_h
            left_w = max(160, int(sh * 0.38))
            cx = left_w / 2.0
            icon_r = min(f_size * 0.55, row_h * 0.4)
            trophy_cell = icon_r * TROPHY_CELL_MULT
            trophy_gap = icon_r * TROPHY_GAP_MULT
            board_w = 5 * trophy_cell + 4 * trophy_gap
            board_scale = min(1.0, (left_w - 20) / board_w)
            counter_y = sh - 25 - row_h * 1.2 * 3 - trophy_cell * board_scale - row_h * 0.8
            self._draw_autosave_counter(counter_y, x_center=cx, group=self.hud_dynamic_group)

    def _update_hud_state(self):
        static_cur = (self.level, self.num_doors, tuple(self.collected_trophies))
        if getattr(self, 'hud_static_state', None) != static_cur:
            self.hud_static_state = static_cur
            self.draw_hud_static()

        self._update_hud_fps()

        dyn_cur = (self.full_sleep_cycles, self._get_slept_pct())
        if getattr(self, 'hud_dynamic_state', None) != dyn_cur:
            self.hud_dynamic_state = dyn_cur
            self.draw_hud_dynamic()


