    def _prepare_door_data(self):
        app = App.get_running_app()
        pre_doors = None
        pre_colors = None
        if app is not None and app.pre_gen_data is not None:
            pre_doors = app.pre_gen_data.get('door_edges')
            pre_colors = app.pre_gen_data.get('door_colors')

        if pre_doors is not None:
            self.door_edges = pre_doors
        else:
            self.door_edges = self._compute_dead_end_doors()

        self.doors = set(self.door_edges.values())
        self.num_doors = len(self.doors)
        self.num_colors = min(len(FIXED_DOOR_COLORS), max(1, self.num_doors)) if self.num_doors > 0 else 1
        self.color_palette = list(FIXED_DOOR_COLORS[:self.num_colors])

        valid = False
        if isinstance(pre_colors, dict):
            valid = True
            for edge in self.doors:
                cid = pre_colors.get(edge)
                if cid is None or not (0 <= cid < self.num_colors):
                    valid = False
                    break

        if valid:
            self.door_color_id = pre_colors
        else:
            self.door_color_id = self._assign_door_colors_spatially(self.doors, self.num_colors)
            try:
                if app is not None and app.pre_gen_data is not None:
                    app.pre_gen_data['door_colors'] = self.door_color_id
            except Exception:
                pass

        self.door_counts = [0] * self.num_colors
        for dk in self.doors:
            cid = self.door_color_id.get(dk)
            if cid is not None and 0 <= cid < self.num_colors:
                self.door_counts[cid] += 1
        self._door_counts_tuple = tuple(self.door_counts)

        self.pocket_cells = set()
        if app is not None and app.pre_gen_data is not None:
            self.pocket_cells = set(app.pre_gen_data.get('pocket_cells', []))

    def get_occupied_cells(self, pixel_pos):
        eps = 1e-3
        vx = pixel_pos.x / TOTAL_STEP
        vy = pixel_pos.y / TOTAL_STEP
        return {(math.floor(vx + eps), math.floor(vy + eps)),
                (math.ceil(vx - eps),  math.floor(vy + eps)),
                (math.floor(vx + eps), math.ceil(vy - eps)),
                (math.ceil(vx - eps),  math.ceil(vy - eps))}

    def get_avail(self, x, y):
        return self.cell_avails.get((x, y), [])

    def get_avail_for_color(self, x, y, cid):
        if cid is None:
            return self.cell_avails.get((x, y), [])
        d = self.cell_avails_by_color.get(cid)
        return d.get((x, y), []) if d else self.cell_avails.get((x, y), [])

    def _has_adjacent_door(self, gx, gy):
        cell = (gx, gy)
        for nb in self.adj_list.get(cell, []):
            key = (cell, nb) if cell < nb else (nb, cell)
            if key in self.doors:
                return True
        return False

    def _compute_intent(self, en, occupied, extra_blocked):
        gx, gy = en['current_cell']
        av_all = self.get_avail_for_color(gx, gy, en.get('color_id'))
        free = []
        for d in av_all:
            tx, ty = gx + int(d.x), gy + int(d.y)
            if (tx, ty) in occupied or (tx, ty) in extra_blocked:
                continue
            free.append(d)
        if not free:
            return None
        cur_dir = en['dir']
        if cur_dir == VEC_ZERO:
            for pref in (Vector(0, 1), Vector(1, 0), Vector(0, -1), Vector(-1, 0)):
                if pref in free:
                    return (gx + int(pref.x), gy + int(pref.y))
            d = free[0]
            return (gx + int(d.x), gy + int(d.y))
        dx, dy = int(cur_dir.x), int(cur_dir.y)
        right    = Vector(dy, -dx)
        straight = Vector(dx, dy)
        left     = Vector(-dy, dx)
        back     = Vector(-dx, -dy)
        if en['turn_rule'] == 'left':
            priority = (left, straight, right, back)
        else:
            priority = (right, straight, left, back)
        for d in priority:
            if d in free:
                return (gx + int(d.x), gy + int(d.y))
        return None

    def _resolve_enemy_intents(self, active_enemies=None):
        if active_enemies is None:
            active_enemies = self.enemies
        occupied = {en['current_cell'] for en in self.enemies}
        blocked = set()
        intents = {en['idx']: self._compute_intent(en, occupied, blocked) for en in active_enemies}
        for _ in range(30):
            counts = {}
            for v in intents.values():
                if v is not None:
                    counts[v] = counts.get(v, 0) + 1
            disputed = {cell for cell, cnt in counts.items() if cnt > 1}
            newly_blocked = disputed - blocked
            if not newly_blocked:
                break
            blocked |= newly_blocked
            for en in active_enemies:
                if intents[en['idx']] in newly_blocked:
                    intents[en['idx']] = self._compute_intent(en, occupied, blocked)
        counts = {}
        for v in intents.values():
            if v is not None:
                counts[v] = counts.get(v, 0) + 1
        for en in active_enemies:
            v = intents[en['idx']]
            if v is not None and counts.get(v, 0) > 1:
                intents[en['idx']] = None
        return intents

    def get_topological_distances(self, start_grid, targets=None):
        dist = {start_grid: 0}
        q = deque([start_grid])
        t_left = set(targets) if targets else None
        if t_left and start_grid in t_left:
            t_left.remove(start_grid)
            if not t_left: return dist
        while q:
            cur = q.popleft()
            for nxt in self.adj_list[cur]:
                if nxt not in dist:
                    dist[nxt] = dist[cur] + 1
                    q.append(nxt)
                    if t_left and nxt in t_left:
                        t_left.remove(nxt)
                        if not t_left: return dist
        return dist

    def _refresh_player_dists(self):
        start_cell = (int(self.player_grid.x), int(self.player_grid.y))
        targets = {self.hatch_pos}
        for en in self.enemies:
            targets.add(en['current_cell'])
        for pos in self.ground_buttons:
            targets.add(pos)
        self.player_dists = self.get_topological_distances(start_cell, targets)
        self._refresh_button_distance()

    def _refresh_button_distance(self):
        self.cached_btn_dist = None
        self.cached_btn_color = None
        if self.hatch_open:
            d = self.player_dists.get(self.hatch_pos, 9999)
            if d < 9999:
                self.cached_btn_dist = d
            return
        if not self.ground_buttons:
            return
        min_d, min_color, tied = 9999, None, False
        for pos, cid in self.ground_buttons.items():
            d = self.player_dists.get(pos, 9999)
            if d < min_d:
                min_d, min_color, tied = d, cid, False
            elif d == min_d:
                tied = True
        if min_d < 9999 and not tied:
            self.cached_btn_dist = min_d
            self.cached_btn_color = min_color

    def _get_compass_target(self):
        if self.hatch_open:
            return self.hatch_pos
        if self.ground_buttons:
            min_d, target, tied = 9999, None, False
            for pos in self.ground_buttons:
                d = self.player_dists.get(pos, 9999)
                if d < min_d:
                    min_d, target, tied = d, pos, False
                elif d == min_d:
                    tied = True
            if not tied and target is not None:
                return target
        min_d, target, tied = 9999, None, False
        for en in self.enemies:
            if not en.get('is_carrier', False):
                continue
            d = self.player_dists.get(en['current_cell'], 9999)
            if d < min_d:
                min_d, target, tied = d, en['current_cell'], False
            elif d == min_d:
                tied = True
        if not tied and target is not None:
            return target
        return None

    def _update_compass(self):
        if not self.IS_LARGE:
            self.compass_dir = None
            return
        target_cell = self._get_compass_target()
        if target_cell is None:
            self.compass_dir = None
            return

        cur_cell = (int(self.player_grid.x), int(self.player_grid.y))
        if cur_cell == target_cell:
            self.compass_dir = None
            return

        cache = self._compass_cache
        if cache is None or cache[0] != target_cell:
            cache = (target_cell, self.get_topological_distances(target_cell))
            self._compass_cache = cache
        dist_map = cache[1]

        cur_d = dist_map.get(cur_cell, 999999)

        best_d = cur_d
        best_dir = None
        for nb in self.adj_list.get(cur_cell, []):
            d = dist_map.get(nb, 999999)
            if d < best_d:
                best_d = d
                best_dir = (nb[0] - cur_cell[0], nb[1] - cur_cell[1])

        self.compass_dir = best_dir

    def _get_los_chain(self, ex, ey, dx, dy):
        key = (ex, ey, dx, dy)
        chain = self._los_cache.get(key)
        if chain is not None:
            return chain
        ds = 'E' if dx == 1 else 'W' if dx == -1 else 'N' if dy == 1 else 'S'
        chain = []
        cx, cy = ex, ey
        while True:
            if self.maze_data[cy][cx][ds] == 1:
                break
            nx, ny = cx + dx, cy + dy
            a, b = (cx, cy), (nx, ny)
            edge = (a, b) if a < b else (b, a)
            if edge in self.doors:
                break
            cx, cy = nx, ny
            chain.append((cx, cy))
        if len(self._los_cache) > 50000:
            self._los_cache.clear()
        self._los_cache[key] = chain
        return chain

    def get_enemy_los(self, en, enemy_positions):
        if en.get('sleep_counter', 0) > 0 or en.get('_just_woke', False):
            return set()
        ex, ey = en['current_cell']
        edir = en['dir']
        if edir == VEC_ZERO:
            return set()
        dx, dy = int(edir.x), int(edir.y)
        chain = self._get_los_chain(ex, ey, dx, dy)
        if not chain:
            return set()
        visible = set()
        for cell in chain:
            if cell in enemy_positions:
                break
            visible.add(cell)
        return visible

    def _check_hatch_open(self, app):
        if self.hatch_open:
            return
        if self.collected_count >= BUTTONS_TO_OPEN:
            self.hatch_open = True
            if self.snd_hatch and not app.is_muted:
                self.snd_hatch.play()

    def _drop_button(self, en):
        if not en.get('is_carrier', False):
            return
        pos = en['current_cell']
        edge = self.door_edges.get(pos)
        cid = self.door_color_id.get(edge, 0) if edge is not None else 0
        self.ground_buttons[pos] = cid
        en['is_carrier'] = False
        self._update_carrier_visual(en)
        self.interactive_redraw_needed = True
        app = App.get_running_app()
        if 0 <= cid < len(self.snd_enemy_drop):
            snd = self.snd_enemy_drop[cid]
            if snd and not app.is_muted:
                snd.play()

    def _pickup_button(self, en):
        if en.get('is_carrier', False):
            return
        pos = en['current_cell']
        if pos not in self.ground_buttons:
            return
        cid = self.ground_buttons[pos]
        del self.ground_buttons[pos]
        en['is_carrier'] = True
        self._update_carrier_visual(en)
        self.interactive_redraw_needed = True
        app = App.get_running_app()
        if 0 <= cid < len(self.snd_enemy_pickup):
            snd = self.snd_enemy_pickup[cid]
            if snd and not app.is_muted:
                snd.play()

    def _get_slept_pct(self):
        total = len(self.enemies)
        if total == 0:
            return 0
        return int(100 * (total - len(self.sleep_cycle_set)) / total)

    def save_game_state(self):
        enemies_state = []
        for en in self.enemies:
            enemies_state.append({
                'idx': en['idx'], 'color': en['color'], 'speed': en['speed'],
                'pattern_idx': en['pattern_idx'], 'turn_rule': en['turn_rule'],
                'mark_color': en['mark_color'], 'color_id': en['color_id'],
                'is_carrier': en['is_carrier'],
                'grid_x': en['grid'].x, 'grid_y': en['grid'].y,
                'pixel_x': en['pixel'].x, 'pixel_y': en['pixel'].y,
                'dir_x': en['dir'].x, 'dir_y': en['dir'].y,
                'last_dir_x': en['last_dir'].x, 'last_dir_y': en['last_dir'].y,
                'current_cell': en['current_cell'], 'next_cell': en['next_cell'],
                'sleep_counter': int(en.get('sleep_counter', 0)),
            })
        state = {
            'version': self.SAVE_VERSION,
            'collected_trophies': list(self.collected_trophies),
            'hatch_open': self.hatch_open,
            'ground_buttons': dict(self.ground_buttons),
            'full_sleep_cycles': self.full_sleep_cycles,
            'player_grid_x': self.player_grid.x, 'player_grid_y': self.player_grid.y,
            'p_pixel_x': self.p_pixel.x, 'p_pixel_y': self.p_pixel.y,
            'p_dir_x': self.p_dir.x, 'p_dir_y': self.p_dir.y,
            'last_p_dir_x': self.last_p_dir.x, 'last_p_dir_y': self.last_p_dir.y,
            'enemies': enemies_state, 'enemy_time': self.enemy_time,
            'sleep_cycle_set': set(self.sleep_cycle_set),
        }
        try:
            new_path = create_new_save_path()
        except Exception:
            return

        loaded_prev = getattr(self, '_loaded_from_prev', False)
        locked_prev = getattr(self, '_locked_prev_path', None)

        def _do_save(path, st, lp, lprev):
            tmp_path = path + '.tmp'
            try:
                with open(tmp_path, 'wb') as f:
                    pickle.dump(st, f)
                os.replace(tmp_path, path)
                if lprev:
                    keep = [path]
                    if lp:
                        keep.append(lp)
                    cleanup_except(keep)
                else:
                    cleanup_old_saves(keep=2)
            except Exception:
                try:
                    if os.path.exists(tmp_path):
                        os.remove(tmp_path)
                except OSError:
                    pass

        threading.Thread(target=_do_save,
                         args=(new_path, state, locked_prev, loaded_prev),
                         daemon=True).start()

