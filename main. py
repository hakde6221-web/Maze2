def _compute_hud_dims(sw, has_autosave_digit=False):
    f_size = max(14, int(sw / 30))
    row_h = int(f_size * 1.7)
    trophy_h = int(row_h * 1.2)
    autosave_h = int(row_h * 0.9)
    hud_h = row_h + trophy_h + autosave_h + 8
    return f_size, row_h, trophy_h, autosave_h, hud_h


